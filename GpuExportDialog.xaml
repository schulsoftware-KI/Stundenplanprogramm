<Window x:Class="Stundenplan_V2.GpuExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GPU002-Export – Unterrichte wählen" Width="960" Height="760"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Waehle die zu exportierenden Unterrichte. Ueber die Filterlisten (Mehrfachauswahl mit Strg/Shift) werden passende U-Nrn rechts vorausgewaehlt; die U-Nr-Liste kann zusaetzlich direkt bearbeitet werden. Bleiben alle Filter UND die U-Nr-Liste leer, werden ALLE Unterrichte exportiert."/>

        <!-- Zeichensatz -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Zeichensatz:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <RadioButton x:Name="RbUtf8"    Content="UTF-8 (ohne BOM)"        GroupName="Enc" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <RadioButton x:Name="RbUtf8Bom" Content="UTF-8 (mit BOM)"         GroupName="Enc" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <RadioButton x:Name="RbAnsi"    Content="ANSI (Windows-1252)"     GroupName="Enc" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- ZZ-Trick + Lösung -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox x:Name="ChkZz" Content="ZZ-Lehrer-Trick fuer die gewaehlten U-Nrn"
                      VerticalAlignment="Center" Margin="0,0,20,0"
                      Checked="ChkZz_Changed" Unchecked="ChkZz_Changed"/>
            <TextBlock Text="Loesung (Slot-Quelle fuer ZZ):" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="CboLoesung" Width="240" VerticalAlignment="Center" IsEnabled="False"/>
        </StackPanel>

        <!-- ZZ-Quelle: UV-Sheet (bisheriges Verhalten) oder bestehende GPU002-Datei -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="ZZ-Quelle:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <RadioButton x:Name="RbZzQuelleUv" GroupName="ZzQuelle" Content="UV-Sheet (mit Auswahl)"
                         IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0"
                         Checked="RbZzQuelle_Changed"/>
            <RadioButton x:Name="RbZzQuelleGpu" GroupName="ZzQuelle" Content="GPU002-Datei (1:1 + ZZ)"
                         VerticalAlignment="Center" Margin="0,0,16,0"
                         Checked="RbZzQuelle_Changed"/>
            <Button x:Name="BtnGpuQuelle" Content="GPU002-Datei…" Width="130" IsEnabled="False"
                    Margin="0,0,10,0" Click="BtnGpuQuelle_Click"/>
            <TextBlock x:Name="TxtGpuQuelle" VerticalAlignment="Center" Foreground="#555"
                       Text="(keine Datei gewaehlt)"/>
        </StackPanel>

        <!-- Filterlisten + UNr-Liste -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="0" Grid.Row="0" Text="Klassen" FontWeight="Bold" Margin="2"/>
            <ListBox  Grid.Column="0" Grid.Row="1" x:Name="LstKlassen" SelectionMode="Multiple" Margin="2"
                      SelectionChanged="Filter_SelectionChanged"/>

            <TextBlock Grid.Column="1" Grid.Row="0" Text="Lehrer" FontWeight="Bold" Margin="2"/>
            <ListBox  Grid.Column="1" Grid.Row="1" x:Name="LstLehrer" SelectionMode="Multiple" Margin="2"
                      SelectionChanged="Filter_SelectionChanged"/>

            <TextBlock Grid.Column="2" Grid.Row="0" Text="Faecher" FontWeight="Bold" Margin="2"/>
            <ListBox  Grid.Column="2" Grid.Row="1" x:Name="LstFaecher" SelectionMode="Multiple" Margin="2"
                      SelectionChanged="Filter_SelectionChanged"/>

            <TextBlock Grid.Column="3" Grid.Row="0" Text="ZeilenText-2" FontWeight="Bold" Margin="2"/>
            <ListBox  Grid.Column="3" Grid.Row="1" x:Name="LstZeilentext2" SelectionMode="Multiple" Margin="2"
                      SelectionChanged="Filter_SelectionChanged"/>

            <TextBlock Grid.Column="4" Grid.Row="0" Text="U-Nrn (Auswahl)" FontWeight="Bold" Margin="2"/>
            <ListBox  Grid.Column="4" Grid.Row="1" x:Name="LstUNrn" SelectionMode="Extended" Margin="2"/>
        </Grid>

        <!-- Buttons für die UNr-Liste -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,6,0,0">
            <Button x:Name="BtnFilterUebernehmen" Content="Aus Filter uebernehmen" Width="180" Margin="0,0,6,0" Click="BtnFilterUebernehmen_Click"/>
            <Button x:Name="BtnAlle"   Content="Alle"     Width="70" Margin="0,0,6,0" Click="BtnAlle_Click"/>
            <Button x:Name="BtnKeine"  Content="Keine"    Width="70" Margin="0,0,6,0" Click="BtnKeine_Click"/>
            <TextBlock x:Name="TxtAnzahl" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#555"/>
        </StackPanel>

        <TextBlock Grid.Row="6" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#555"
                   Text="Hinweis: Ist der ZZ-Lehrer-Trick aktiv, wird zusaetzlich eine Zeitwunsch-Datei (GPU016_ZZ) erzeugt, die die Dummy-Lehrer ausserhalb ihres Slots sperrt. Beide Dateien zusammen in Untis importieren. — ZZ-Quelle 'GPU002-Datei': die gewaehlte Datei wird Zeile fuer Zeile byte-identisch uebernommen und jede verplante Zeile zusaetzlich mit ZZ-Lehrer geschrieben; Filter/U-Nr-Auswahl und Zeichensatz werden in diesem Modus ignoriert."/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnOk"        Content="Weiter" Width="100" Margin="0,0,5,0" Click="BtnOk_Click" IsDefault="True"/>
            <Button x:Name="BtnAbbrechen" Content="Abbrechen" Width="100" Click="BtnAbbrechen_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
