<Window x:Class="Stundenplan_V2.IgnoreDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gezielt ignorieren" Width="900" Height="580"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"
                   Text="Filter auswählen (Mehrfachauswahl mit Strg/Shift). Verknüpfung ODER: Treffer, sobald ein Wert in IRGENDEINER Liste passt. Verknüpfung UND (Kombination): Treffer nur, wenn JEDE Liste mit Auswahl passt — leere Listen zählen als 'egal'."/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Aktion:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <RadioButton x:Name="RbIgnorieren"      Content="Treffer mit 'i' markieren (ignorieren)"      GroupName="Aktion" IsChecked="True" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <RadioButton x:Name="RbNichtIgnorieren" Content="'i' aus Treffern entfernen (nicht ignorieren)" GroupName="Aktion" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Verknüpfung:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <RadioButton x:Name="RbOder" Content="ODER (ein Kriterium reicht)"        GroupName="Verknuepfung" IsChecked="True" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <RadioButton x:Name="RbUnd"  Content="UND (Kombination — alle Kriterien)" GroupName="Verknuepfung"                  VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="0" Grid.Row="0" Text="Klassen" FontWeight="Bold" Margin="2"/>
            <ListBox  Grid.Column="0" Grid.Row="1" x:Name="LstKlassen" SelectionMode="Multiple" Margin="2"/>

            <TextBlock Grid.Column="1" Grid.Row="0" Text="Lehrer" FontWeight="Bold" Margin="2"/>
            <ListBox  Grid.Column="1" Grid.Row="1" x:Name="LstLehrer" SelectionMode="Multiple" Margin="2"/>

            <TextBlock Grid.Column="2" Grid.Row="0" Text="Fächer" FontWeight="Bold" Margin="2"/>
            <ListBox  Grid.Column="2" Grid.Row="1" x:Name="LstFächer" SelectionMode="Multiple" Margin="2"/>

            <TextBlock Grid.Column="3" Grid.Row="0" Text="ZeilenText-2" FontWeight="Bold" Margin="2"/>
            <ListBox  Grid.Column="3" Grid.Row="1" x:Name="LstZeilentext2" SelectionMode="Multiple" Margin="2"/>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnOk"        Content="Ausführen" Width="100" Margin="0,0,5,0" Click="BtnOk_Click"        IsDefault="True"/>
            <Button x:Name="BtnAbbrechen" Content="Abbrechen" Width="100"                Click="BtnAbbrechen_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
