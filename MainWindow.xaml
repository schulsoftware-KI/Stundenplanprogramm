<Window x:Class="Stundenplan_V2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stundenplan V2"
        Height="1000"
        Width="900"
        MinHeight="700"
        MinWidth="820"
        FontSize="15"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Stundenplan-Generator" FontSize="23"
                       FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TxtDatei" Text="Keine Datei geladen" FontSize="17"
                       FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
            <Button Content="Ausgabe-Fenster anzeigen" HorizontalAlignment="Center"
                    Margin="0,8,0,0" Padding="12,4" Click="BtnAusgabeFenster_Click"/>
            <TextBlock HorizontalAlignment="Center" Margin="0,8,0,0"
                       FontSize="12" Foreground="#444" TextWrapping="Wrap"
                       MaxWidth="760" TextAlignment="Center" LineHeight="17"
                       Text="Solver-Modus, Aufgabentyp (Vollplan/Teilplan), Zeitlimit und alle Schnellsolver-Optionen werden gebündelt über Knopf 10 „Solverlauf“ eingestellt und gestartet."/>
        </StackPanel>

        <!-- Buttons: schmaler, zweispaltig statt einer langen Reihe -> gibt dem
             Meldefenster (TxtLog) darunter deutlich mehr Platz. -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.Resources>
                <Style TargetType="Button">
                    <Setter Property="Padding" Value="6,9"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Grid.Column="0" Content="1. Excel-Datei einlesen" Margin="0,0,6,10" Click="BtnPfad_Click"/>
            <Button Grid.Row="0" Grid.Column="1" Content="2. Zeitwünsche einlesen/exportieren" Margin="6,0,0,10" Click="BtnZeitwuensche_Click"/>

            <!-- Drei Buttons nebeneinander (etwas schmaler als die zweispaltigen Buttons) -->
            <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Margin="0,0,4,0" Click="BtnPlanImportieren_Click">
                    <TextBlock Text="3. Plan importieren" TextWrapping="Wrap" TextAlignment="Center" FontSize="13"/>
                </Button>
                <Button Grid.Column="1" Margin="4,0,4,0" Click="BtnUnrPlan_Click">
                    <TextBlock Text="4. Plan bewerten" TextWrapping="Wrap" TextAlignment="Center" FontSize="13"/>
                </Button>
                <Button Grid.Column="2" Margin="4,0,0,0" Click="BtnPlanPrüfen_Click">
                    <TextBlock Text="5. Plan prüfen (Verletzungen)" TextWrapping="Wrap" TextAlignment="Center" FontSize="13"/>
                </Button>
            </Grid>

            <Button Grid.Row="2" Grid.Column="0" Content="6. UV als GPU importieren" Margin="0,0,6,10" Click="BtnGpuImport_Click"/>
            <Button Grid.Row="2" Grid.Column="1" Content="7. UV als GPU exportieren" Margin="6,0,0,10" Click="BtnGpuExport_Click"/>

            <Button Grid.Row="3" Grid.Column="0" Content="8. Gezielt fixieren und ignorieren" Margin="0,0,6,10" Click="BtnFixierenIgnorieren_Click"/>
            <Button Grid.Row="3" Grid.Column="1" Content="9. PM-Parameter bearbeiten" Margin="6,0,0,10" Click="BtnPmBearbeiten_Click"/>

            <Button Grid.Row="4" Grid.Column="0" Content="10. Solverlauf (einstellen &amp; starten)" Margin="0,0,6,10" Click="BtnSolverlauf_Click"/>
            <Button Grid.Row="4" Grid.Column="1" Content="11. Plan-Editor (interaktiv)" Margin="6,0,0,10" Click="BtnPlanEditor_Click"/>

            <Button Grid.Row="5" Grid.Column="0" Content="12. Lösung sichern" Margin="0,0,6,10" Click="BtnLoesungSichern_Click"/>
            <Button Grid.Row="5" Grid.Column="1" Content="13. Lösungen löschen" Margin="6,0,0,10" Click="BtnLoesungenLoeschen_Click"/>

            <Button Grid.Row="6" Grid.Column="0" Content="14. Lösung verbessern" Margin="0,0,6,10" Click="BtnPlanVerbessern_Click"/>
            <Button Grid.Row="6" Grid.Column="1" Content="15. Minimale Änderungen (Solver)" Margin="6,0,0,10" Click="BtnMinimalAenderung_Click"/>

            <Button Grid.Row="7" Grid.Column="0" Content="16. Fixierungen/Lösung exportieren (Plan/Lös)" Margin="0,0,6,10" Click="BtnFixExport_Click"/>
            <Button Grid.Row="7" Grid.Column="1" Content="17. Diagnose an Diag anhängen" Margin="6,0,0,10" Click="BtnDiagAnhaengen_Click"/>

            <Button Grid.Row="8" Grid.Column="0" Content="18. Klassenpläne erzeugen" Margin="0,0,6,10" Click="BtnKlassenplaene_Click"/>
            <Button Grid.Row="8" Grid.Column="1" Content="19. Klassenpläne EF / Q1 / Q2" Margin="6,0,0,10" Click="BtnKlassenplaeneOberstufe_Click"/>

            <Button Grid.Row="9" Grid.Column="0" Content="20. Lehrerpläne erzeugen" Margin="0,0,6,10" Click="BtnLehrerplaene_Click"/>
            <Button Grid.Row="9" Grid.Column="1" Content="21. Stammdaten (StD) bearbeiten" Margin="6,0,0,10" Click="BtnStammdaten_Click"/>
        </Grid>

        <!-- Meldefenster (Protokoll-Log): bekommt durch die zweispaltigen Buttons
             oben jetzt deutlich mehr Höhe (Row="*" statt vieler Auto-Button-Zeilen). -->
        <!-- TextWrapping="Wrap": lange Zeilen (Diagnosetexte, Dateipfade,
             Tausch-Keys) werden umgebrochen statt nach rechts aus dem
             sichtbaren Bereich zu laufen. Der waagerechte Rollbalken entfällt
             damit; VerticalScrollBarVisibility bleibt auf "Auto". -->
        <TextBox x:Name="TxtLog" Grid.Row="2" Margin="0,0,0,10"
                 FontSize="15"
                 TextWrapping="Wrap"
                 HorizontalScrollBarVisibility="Disabled"
                 VerticalScrollBarVisibility="Auto" AcceptsReturn="True"
                 IsReadOnly="True" FontFamily="Consolas"/>

        <Border Grid.Row="3" Background="#F0F0F0" Padding="10" CornerRadius="5">
            <TextBlock x:Name="TxtStatus" Text="Bereit." FontSize="15" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>
