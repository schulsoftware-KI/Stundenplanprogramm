<Window x:Class="Stundenplan_V2.PMParameterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PM-Parameter bearbeiten"
        Width="860" Height="640"
        MinWidth="620" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap"
                    Text="Alle Zeilen der Tabelle 'PM' (Spalte A = Parameter, Spalte B = Wert, Spalte C = Bemerkung). Werte in 'Wert' und Erläuterungen in 'Bemerkung' direkt bearbeiten und speichern — die Excel-Datei wird danach automatisch neu eingelesen und das Fenster schließt sich. Spalte C ist reine Dokumentation und wird beim Einlesen nicht ausgewertet."/>

        <DataGrid x:Name="DgParameter" Grid.Row="1"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  GridLinesVisibility="All"
                  VerticalGridLinesBrush="#888" HorizontalGridLinesBrush="#CCC"
                  AlternatingRowBackground="#F2F4F8" RowBackground="White"
                  Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Parameter (Spalte A)" Binding="{Binding Beschriftung}" Width="2*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Wert (Spalte B)" Binding="{Binding Wert, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <!-- Spalte C: reine Bemerkung/Dokumentation, editierbar. Lange
                     Texte umbrechen (Anzeige und Editor), damit sie lesbar sind. -->
                <DataGridTextColumn Header="Bemerkung (Spalte C)" Binding="{Binding Bemerkung, UpdateSourceTrigger=PropertyChanged}" Width="2*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="AcceptsReturn" Value="True"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Nur ein Button: Änderungen werden nie verworfen, gespeichert wird
             immer. Schließen erledigt der Speichern-Vorgang selbst (siehe
             BtnSpeichern_Click). -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnSpeichern" Content="Speichern und schließen" Width="180"
                    Click="BtnSpeichern_Click"/>
        </StackPanel>
    </Grid>
</Window>
