<Window x:Class="Stundenplan_V2.SchnellSolverDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Schneller Solver – Optionen"
        Height="720" Width="520"
        MinHeight="400" MinWidth="480" MaxHeight="1000"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <!-- 2 Zeilen: scrollbarer Inhalt (oben) + fest verankerte Buttons (unten). -->
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <StackPanel>

                <!-- Infotext -->
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="Diese Einstellungen gelten nur, wenn 'Schneller Solver' aktiv ist. Der Standard-Solver bleibt davon unberührt."/>

                <!-- Gap -->
                <GroupBox Header="Optimierungs-Genauigkeit (Gap)" Margin="0,0,0,8">
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,0,0,6"
                            Text="Kleinerer Wert = genauer, aber langsamer. 0 = bis zum beweisbaren Optimum (bzw. Zeitlimit). Empfehlung: 2 % für die Bestlösung, 8 % für Folgelösungen."/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Gap Bestlösung (%):" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtGap" Text="2" Width="60" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Gap Folgelösungen (%):" VerticalAlignment="Center" Margin="0,6,0,0"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtGapPhase2" Text="8" Width="60" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                    </Grid>
                </GroupBox>

                <!-- Startlösung -->
                <GroupBox Header="Startlösung" Margin="0,0,0,8">
                    <CheckBox x:Name="ChkGreedy" Margin="5"
                              Content="Greedy-Start-Hint beim ersten Plan setzen (empfohlen)"
                              IsChecked="True"/>
                </GroupBox>

                <!-- Harte Kappungen -->
                <GroupBox Header="Harte Kappungen – Gesamtzahl je Term (leer = aus)" Margin="0,0,0,12">
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="0,0,0,8"
                            Text="Kappt den jeweiligen Straf-Term hart ab (statt ihn nur zu bestrafen) und beschleunigt so die Suche. Wird eine Kappung unlösbar, wiederholt der Solver den Grundlauf automatisch einmal ohne Kappungen.&#10;&#10;Wichtig: Von allen Optionen in diesem Fenster verkürzen nur die Kappungen die Zeit bis zur ersten Lösung. Die Gap-Einstellung oben beschleunigt lediglich den Optimalitätsbeweis danach, nicht das Finden der ersten Lösung."/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Hohlstunden:" VerticalAlignment="Center"/>
                        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TxtMaxHohl" Width="50" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Doppel-Hohlstunden:" VerticalAlignment="Center"/>
                        <TextBox   Grid.Row="1" Grid.Column="3" x:Name="TxtMaxDoppelHohl" Width="50" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Dreifach-Hohlstunden:" VerticalAlignment="Center" Margin="0,6,0,0"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TxtMaxDreifachHohl" Width="50" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Stundenfolge:" VerticalAlignment="Center" Margin="0,6,0,0"/>
                        <TextBox   Grid.Row="2" Grid.Column="3" x:Name="TxtMaxStdFolge" Width="50" HorizontalAlignment="Left" Margin="0,6,0,0"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Späte LK-Stunden:" VerticalAlignment="Center" Margin="0,6,0,0"/>
                        <TextBox   Grid.Row="3" Grid.Column="1" x:Name="TxtMaxSpäteLk" Width="50" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Hauptfach spät:" VerticalAlignment="Center" Margin="0,6,0,0"/>
                        <TextBox   Grid.Row="3" Grid.Column="3" x:Name="TxtMaxHauptfachSpät" Width="50" HorizontalAlignment="Left" Margin="0,6,0,0"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Spät→früh:" VerticalAlignment="Center" Margin="0,6,0,0"/>
                        <TextBox   Grid.Row="4" Grid.Column="1" x:Name="TxtMaxSpätFrüh" Width="50" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="Doppel selber Tag:" VerticalAlignment="Center" Margin="0,6,0,0"/>
                        <TextBox   Grid.Row="4" Grid.Column="3" x:Name="TxtMaxDoppelSelberTag" Width="50" HorizontalAlignment="Left" Margin="0,6,0,0"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Bad Units (päd. spät):" VerticalAlignment="Center" Margin="0,6,0,0"/>
                        <TextBox   Grid.Row="5" Grid.Column="1" x:Name="TxtMaxBadUnits" Width="50" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                    </Grid>
                </GroupBox>

                <!-- Gekoppelte Vorplanung -->
                <GroupBox Header="Gekoppelte Vorplanung (erst Kopplungen, dann Rest)" Margin="0,0,0,4">
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,0,0,8"
                            Text="Plant zuerst nur die stark verkoppelten Unterrichte und erzeugt mehrere gute Anker; fixiert dann jeden Anker und löst den Gesamtplan. Am Ende gewinnt die beste Gesamtlösung. Kern = Unterrichte, deren UNr auf mindestens so vielen UV-Zeilen steht (Kopplungsgrad). Manuelle Fixierungen werden in Phase 1 als feste Hindernisse berücksichtigt.&#10;Kann je nach Ankerzahl deutlich länger dauern (mehrere Gesamtläufe)."/>

                        <CheckBox Grid.Row="1" Grid.ColumnSpan="2" x:Name="ChkGekoppelt" Margin="0,0,0,6"
                                  Content="Gekoppelte Vorplanung aktivieren"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Kern ab … gleichen UNr (Kopplungsgrad):" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtMinGleicheUNr" Text="3" Width="60"
                                 HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Anzahl Anker:" VerticalAlignment="Center" Margin="0,6,0,0"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtAnzahlAnker" Text="5" Width="60"
                                 HorizontalAlignment="Left" Margin="0,6,0,0"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Anker-Mindestabstand (Blöcke):" VerticalAlignment="Center" Margin="0,6,0,0"/>
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtAnkerAbstand" Text="10" Width="60"
                                 HorizontalAlignment="Left" Margin="0,6,0,0"/>

                        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                            <CheckBox x:Name="ChkP1Limit" Content="Eigenes Zeitlimit für Phase 1:" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtP1Limit" Text="90" Width="60" Margin="8,0,0,0"/>
                            <TextBlock Text="Sekunden je Solve" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Buttons: immer sichtbar, außerhalb des Scrollbereichs -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Standardwerte" Width="110" Margin="0,0,8,0"
                    Click="BtnZuruecksetzen_Click"/>
            <Button x:Name="BtnOk" Content="Übernehmen" Width="110" Margin="0,0,8,0"
                    Click="BtnOk_Click"/>
            <Button Content="Abbrechen" Width="100"
                    Click="BtnAbbrechen_Click"/>
        </StackPanel>
    </Grid>
</Window>
