<Window x:Class="Stundenplan_V2.UnterrichteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unterrichte ignorieren / fixieren"
        Width="960" Height="680"
        MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Schnellfilter (wie bisher): Auswahl hier hakt per Klick auf
             "Treffer anhaken" passende Zeilen in der Tabelle unten an. -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="0" Grid.Row="0" Text="Klassen" FontWeight="Bold" Margin="2"/>
            <ListBox  Grid.Column="0" Grid.Row="1" x:Name="LstKlassen" SelectionMode="Multiple" Margin="2"/>

            <TextBlock Grid.Column="1" Grid.Row="0" Text="Lehrer" FontWeight="Bold" Margin="2"/>
            <ListBox  Grid.Column="1" Grid.Row="1" x:Name="LstLehrer" SelectionMode="Multiple" Margin="2"/>

            <TextBlock Grid.Column="2" Grid.Row="0" Text="Fächer" FontWeight="Bold" Margin="2"/>
            <ListBox  Grid.Column="2" Grid.Row="1" x:Name="LstFächer" SelectionMode="Multiple" Margin="2"/>

            <TextBlock Grid.Column="3" Grid.Row="0" Text="ZeilenText-2" FontWeight="Bold" Margin="2"/>
            <ListBox  Grid.Column="3" Grid.Row="1" x:Name="LstZeilentext2" SelectionMode="Multiple" Margin="2"/>
        </Grid>

        <!-- Vorauswahl-Aktionen + Suche -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8">
            <Button x:Name="BtnVorauswahlAnhaken" Content="Treffer anhaken" Padding="8,3" Click="BtnVorauswahlAnhaken_Click"/>
            <Button x:Name="BtnEingefärbteAuswählen" Content="Markierte anhaken" Padding="8,3" Margin="6,0,0,0" Click="BtnEingefärbteAuswählen_Click"
                    ToolTip="Hakt die Checkbox aller aktuell mit der Maus markierten (highlighted) Zeilen an"/>
            <Button x:Name="BtnAuswahlLeeren" Content="Auswahl leeren" Padding="8,3" Margin="6,0,0,0" Click="BtnAuswahlLeeren_Click"/>
            <TextBlock Text="Suche:" VerticalAlignment="Center" Margin="24,0,6,0"/>
            <TextBox x:Name="TxtSuche" Width="240" ToolTip="Filtert die Tabelle nach UNr, Klasse, Fach, Lehrer oder ZeilenText-2"
                     TextChanged="TxtSuche_TextChanged"/>
            <TextBlock x:Name="TxtAnzahlGewählt" VerticalAlignment="Center" Margin="24,0,0,0" FontWeight="Bold" Text="0 ausgewählt"/>

            <Border Background="#FAE8B0" Width="14" Height="14" Margin="24,0,4,0" VerticalAlignment="Center"/>
            <TextBlock Text="ignoriert" VerticalAlignment="Center" Foreground="Gray" FontSize="11"/>
            <Border Background="#CFE2FF" Width="14" Height="14" Margin="12,0,4,0" VerticalAlignment="Center"/>
            <TextBlock Text="fixiert" VerticalAlignment="Center" Foreground="Gray" FontSize="11"/>
            <Border Background="#E5D4F5" Width="14" Height="14" Margin="12,0,4,0" VerticalAlignment="Center"/>
            <TextBlock Text="beides" VerticalAlignment="Center" Foreground="Gray" FontSize="11"/>
        </StackPanel>

        <!-- Einzelzeilen-Tabelle mit Checkboxen -->
        <DataGrid x:Name="DgZeilen" Grid.Row="2" Margin="0,0,0,8"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Extended" GridLinesVisibility="Horizontal"
                  ScrollViewer.CanContentScroll="True">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="{Binding ZeilenFarbe}"/>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="" Binding="{Binding Ausgewählt, UpdateSourceTrigger=PropertyChanged}" Width="34"/>
                <DataGridTextColumn Header="UNr"    Binding="{Binding UNr}"    Width="60"  IsReadOnly="True"/>
                <DataGridTextColumn Header="Klasse" Binding="{Binding Klasse}" Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="Fach"   Binding="{Binding Fach}"   Width="90"  IsReadOnly="True"/>
                <DataGridTextColumn Header="Lehrer" Binding="{Binding Lehrer}" Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="Wst" Binding="{Binding Wst}" Width="50" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="ZeilenText-2" Binding="{Binding Zt2}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="in FixUnr" Binding="{Binding InFixUNr}" Width="70" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="#104AE0"/>
                            <Setter Property="ToolTip" Value="Anzahl der Slots, in denen diese UNr tatsächlich im Sheet 'Fix UNrn' fixiert ist – das wertet der Solver aus (unabhängig vom bloßen 'X' in 'Fix (X)')."/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"   IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Fix-UNrn-Übernahme (nur relevant bei Fixieren/Entfixieren) -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <CheckBox x:Name="ChkFixUNrn" VerticalAlignment="Center" IsChecked="True"
                      Content="Bei Fixieren/Entfixieren zusätzlich in Tabelle 'Fix UNrn' eintragen/entfernen"/>
            <TextBlock Text="Lösung als Quelle:" Margin="20,0,6,0" VerticalAlignment="Center"/>
            <ComboBox x:Name="CboLoesung" Width="220" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Aktionen -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnIgnorieren"      Content="Ignorieren"       Width="110" Margin="0,0,6,0" Click="BtnIgnorieren_Click"/>
            <Button x:Name="BtnNichtIgnorieren" Content="Nicht ignorieren" Width="130" Margin="0,0,6,0" Click="BtnNichtIgnorieren_Click"/>
            <Button x:Name="BtnFixieren"        Content="Fixieren"        Width="100" Margin="0,0,6,0" Click="BtnFixieren_Click"/>
            <Button x:Name="BtnEntfixieren"     Content="Entfixieren"     Width="100" Margin="0,0,20,0" Click="BtnEntfixieren_Click"/>
            <Button x:Name="BtnAbbrechen"       Content="Schließen"       Width="90"  IsCancel="True"  Click="BtnAbbrechen_Click"/>
        </StackPanel>
    </Grid>
</Window>
