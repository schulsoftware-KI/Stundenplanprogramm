<Window x:Class="Stundenplan_V2.DiagFilterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lehrer nach Diag-Kriterien filtern" Width="440" Height="480"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Lehrer-Auswahlliste (links, Lehrerplan) auf Lehrer beschränken, die in der aktuell angezeigten Lösung mindestens eines bzw. alle der gewählten Diag-Kriterien verletzen. Grundlage sind dieselben Werte wie im Diag-Sheet / 'Diag-Werte'-Fenster."/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Verknüpfung:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <RadioButton x:Name="RbOder" Content="ODER (ein Kriterium reicht)" GroupName="Verknuepfung"
                         IsChecked="True" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <RadioButton x:Name="RbUnd" Content="UND (alle gewählten Kriterien)" GroupName="Verknuepfung"
                         VerticalAlignment="Center"/>
        </StackPanel>

        <ListBox Grid.Row="2" x:Name="LstKriterien" SelectionMode="Multiple" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnOk" Content="Filtern" Width="90" Margin="0,0,5,0"
                    Click="BtnOk_Click" IsDefault="True"/>
            <Button x:Name="BtnZuruecksetzen" Content="Filter aufheben" Width="120" Margin="0,0,5,0"
                    Click="BtnZuruecksetzen_Click"/>
            <Button x:Name="BtnAbbrechen" Content="Abbrechen" Width="90"
                    Click="BtnAbbrechen_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
