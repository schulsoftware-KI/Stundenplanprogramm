<Window x:Class="Stundenplan_V2.PlanEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plan-Editor" Width="1800" Height="1144" MinWidth="1100"
        WindowStartupLocation="CenterOwner"
        PreviewMouseWheel="Fenster_PreviewMouseWheel">
    <!-- Wurzel: Kopfleiste und Hinweise oben – sie zoomen NICHT mit –, darunter das gezoomte Grid. -->
    <DockPanel Margin="10">

        <!-- Kopfleiste: eine feste Zeile, bricht nicht um. Links Lösung, Modus und drei
             Klappmenüs (Ansicht, Farben, Vergleich), rechts – rechtsbündig – die Werkzeuge.
             Die Häkchen und Auswahlknöpfe liegen mit unveränderten Namen und Ereignissen in
             den Klappmenüs (Popups); die Knöpfe zeigen den Zustand an
             (PlanEditorDialog_Kopfleiste.cs). -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.Resources>
                <Style x:Key="KlappKopf" TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#666"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Margin" Value="0,2,0,4"/>
                </Style>
                <Style x:Key="KlappRahmen" TargetType="Border">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="BorderBrush" Value="#999"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="CornerRadius" Value="3"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="MinWidth" Value="220"/>
                </Style>
                <Style x:Key="KlappEintrag" TargetType="Control">
                    <Setter Property="Margin" Value="0,3"/>
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" ClipToBounds="True">
                <TextBlock Text="Lösung:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Button x:Name="BtnVorigeLoesung" Content="&#9664;" Width="28" VerticalAlignment="Center"
                        Margin="0,0,2,0" ToolTip="Vorige Loesung" Click="BtnVorigeLoesung_Click"/>
                <ComboBox x:Name="CboLoesung" Width="150" VerticalAlignment="Center" Margin="0,0,2,0"
                          SelectionChanged="CboLoesung_SelectionChanged"/>
                <Button x:Name="BtnNaechsteLoesung" Content="&#9654;" Width="28" VerticalAlignment="Center"
                        Margin="0,0,12,0" ToolTip="Naechste Loesung" Click="BtnNaechsteLoesung_Click"/>
                <Border Width="1" Background="#CCC" Margin="0,3,12,3"/>

                <!-- Modus als Umschalter (Auswahlknöpfe im Aussehen von Umschaltknöpfen). -->
                <TextBlock Text="Modus:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <RadioButton x:Name="RbBlock" Content="Block (ganzer Tag)" GroupName="Modus"
                             Style="{StaticResource {x:Type ToggleButton}}" Padding="8,2" VerticalAlignment="Center"
                             ToolTip="Ziehen verschiebt den ganzen Block eines Tages"/>
                <RadioButton x:Name="RbEinzel" Content="Einzelstunde" GroupName="Modus" IsChecked="True"
                             Style="{StaticResource {x:Type ToggleButton}}" Padding="8,2" VerticalAlignment="Center"
                             Margin="-1,0,12,0"
                             ToolTip="Ziehen verschiebt eine einzelne Stunde; Rechtsklick: fixieren bzw. Fixierung entfernen"/>
                <Border Width="1" Background="#CCC" Margin="0,3,12,3"/>

                <!-- Klappmenü „Ansicht": zusätzliche Pläne und Räume in den Zellen. -->
                <ToggleButton x:Name="TglAnsicht" MinWidth="104" Padding="8,2" Margin="0,0,6,0" VerticalAlignment="Center"
                              HorizontalContentAlignment="Left"
                              ToolTip="Zusätzliche Pläne und Räume in den Zellen ein- und ausschalten">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="LblAnsicht" Text="Ansicht"/>
                        <TextBlock Text=" &#9662;"/>
                    </StackPanel>
                </ToggleButton>
                <Popup x:Name="PopAnsicht" PlacementTarget="{Binding ElementName=TglAnsicht}" Placement="Bottom"
                       StaysOpen="False" IsOpen="{Binding IsChecked, ElementName=TglAnsicht, Mode=TwoWay}"
                       Opened="Klappmenue_Opened" Closed="Klappmenue_Closed">
                    <Border Style="{StaticResource KlappRahmen}" PreviewKeyDown="Klappmenue_PreviewKeyDown">
                        <StackPanel>
                            <TextBlock Text="Zusätzliche Pläne" Style="{StaticResource KlappKopf}"/>
                            <CheckBox x:Name="ChkKlassenVergleich" Content="Klassenvergleich" Style="{StaticResource KlappEintrag}"
                                      Checked="ChkKlassenVergleich_Changed" Unchecked="ChkKlassenVergleich_Changed"/>
                            <CheckBox x:Name="ChkFachgruppenPlan" Content="Fachgruppenplan" Style="{StaticResource KlappEintrag}"
                                      ToolTip="Zusaetzlicher Plan (reine Ansicht): zeigt je Zeitslot alle Bloecke einer Fachgruppe (Sheet FGR) und die Raum-Auslastung. Klick auf einen Unterricht stellt Lehrer- und Klassenplan darauf um."
                                      Checked="ChkFachgruppenPlan_Changed" Unchecked="ChkFachgruppenPlan_Changed"/>
                            <CheckBox x:Name="ChkFaecherPlan" Content="Fächerplan" Style="{StaticResource KlappEintrag}"
                                      ToolTip="Zusaetzlicher Plan (reine Ansicht): zeigt je Zeitslot alle Bloecke EINES Fachs (ueber alle Klassen/Lehrer) und wie viele davon parallel liegen. Kein Raumlimit — nur Parallelitaets-Zaehler. Klick auf einen Unterricht stellt Lehrer- und Klassenplan darauf um."
                                      Checked="ChkFaecherPlan_Changed" Unchecked="ChkFaecherPlan_Changed"/>
                            <!-- Raumplan (R2, PlanEditorDialog_Raeume.cs). Die Raumdaten werden erst beim Einschalten gelesen. -->
                            <CheckBox x:Name="ChkRaumPlan" Content="Raumplan" Style="{StaticResource KlappEintrag}"
                                      ToolTip="Zusaetzlicher Plan (reine Ansicht): zeigt je Zeitslot, welcher Unterricht in dem gewaehlten Raum liegt. Klick auf einen Unterricht stellt Lehrer- und Klassenplan darauf um."
                                      Checked="ChkRaumPlan_Changed" Unchecked="ChkRaumPlan_Changed"/>
                            <TextBlock Text="In den Zellen" Style="{StaticResource KlappKopf}" Margin="0,8,0,4"/>
                            <CheckBox x:Name="ChkRaeume" Content="Räume (oben rechts in jeder Stunde)" Style="{StaticResource KlappEintrag}"
                                      ToolTip="Zeigt in Lehrer- und Klassenplan je Stunde den Raum (oben rechts). Grün = gespeichert (Blatt „Raumplan“), grau = verteilt (noch kein Raumplan gespeichert), blau = fest, orange * = geändert und noch nicht gespeichert, gelb ? = Raum offen (Stunde verschoben), rot = kein freier Raum. Räume werden nur auf Nachfrage verteilt: Verschieben und Tauschen ändern keinen Raum, verschobene Stunden bleiben offen bis „Räume verteilen“. Rechtsklick auf eine Stunde: Raum ändern."
                                      Checked="ChkRaeume_Changed" Unchecked="ChkRaeume_Changed"/>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Klappmenü „Farben": Färbung der Zellen, Farben festlegen, Markierungen. -->
                <ToggleButton x:Name="TglFarben" MinWidth="176" Padding="8,2" Margin="0,0,6,0" VerticalAlignment="Center"
                              HorizontalContentAlignment="Left"
                              ToolTip="Zellen nach Klasse/Fach färben, Farben festlegen, späte päd. Einheiten markieren">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="LblFarben" Text="Farben: aus"/>
                        <TextBlock Text=" &#9662;"/>
                    </StackPanel>
                </ToggleButton>
                <Popup x:Name="PopFarben" PlacementTarget="{Binding ElementName=TglFarben}" Placement="Bottom"
                       StaysOpen="False" IsOpen="{Binding IsChecked, ElementName=TglFarben, Mode=TwoWay}"
                       Opened="Klappmenue_Opened" Closed="Klappmenue_Closed">
                    <Border Style="{StaticResource KlappRahmen}" PreviewKeyDown="Klappmenue_PreviewKeyDown">
                        <StackPanel>
                            <!-- Umschalter, wonach gefaerbt wird: reine Sitzungs-/EdCfg-Einstellung;
                                 die Farben selbst liegen im Sheet "Farben". -->
                            <TextBlock Text="Zellen färben nach" Style="{StaticResource KlappKopf}"/>
                            <RadioButton x:Name="RbFarbeAus" Content="aus" GroupName="Farbcode" IsChecked="True"
                                         Style="{StaticResource KlappEintrag}" Checked="FarbModus_Changed"/>
                            <RadioButton x:Name="RbFarbeKlasse" Content="Klasse" GroupName="Farbcode"
                                         Style="{StaticResource KlappEintrag}" Checked="FarbModus_Changed"/>
                            <RadioButton x:Name="RbFarbeFach" Content="Fach" GroupName="Farbcode"
                                         Style="{StaticResource KlappEintrag}" Checked="FarbModus_Changed"/>
                            <RadioButton x:Name="RbFarbeBeide" Content="Klasse + Fach" GroupName="Farbcode"
                                         Style="{StaticResource KlappEintrag}" Checked="FarbModus_Changed"
                                         ToolTip="Zweizonig: farbiger Rand = Klasse, Textfläche = Fach. Hat nur eine der beiden eine Farbe, wird die Zelle wie gewohnt einfarbig."/>
                            <Button x:Name="BtnFarbcode" Content="Farben festlegen …" HorizontalAlignment="Left"
                                    Margin="0,6,0,0" Padding="8,2"
                                    ToolTip="Hintergrundfarben für Klassen und Fächer festlegen (wird dauerhaft im Sheet 'Farben' der Excel-Datei gespeichert)"
                                    Click="BtnFarbcode_Click"/>
                            <TextBlock Text="Markieren" Style="{StaticResource KlappKopf}" Margin="0,10,0,4"/>
                            <CheckBox x:Name="ChkSpaetePaed" Content="Späte nichtfixierte päd. Einheiten rot"
                                      Style="{StaticResource KlappEintrag}"
                                      Checked="ChkSpaetePaed_Changed" Unchecked="ChkSpaetePaed_Changed"/>
                            <CheckBox x:Name="ChkSpaetePaedFix" Content="auch fixierte (heller)" Margin="18,3,0,3"
                                      ToolTip="Markiert zusaetzlich die voll fixierten spaeten paed. Einheiten in hellerem Rot. Kraeftiges Rot = spaet und noch bewegbar, helleres Rot = spaet und voll fixiert (nur ohne Entfixieren aenderbar)."
                                      Checked="ChkSpaetePaedFix_Changed" Unchecked="ChkSpaetePaedFix_Changed"/>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Klappmenü „Vergleich": Vergleichsmodus und seine Optionen; die Auswahl der
                     2. Lösung steht bei eingeschaltetem Modus direkt hinter dem Knopf. -->
                <ToggleButton x:Name="TglVergleich" MinWidth="104" Padding="8,2" Margin="0,0,6,0" VerticalAlignment="Center"
                              HorizontalContentAlignment="Left"
                              ToolTip="Zwei Lösungen nebeneinander vergleichen">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="LblVergleich" Text="Vergleich"/>
                        <TextBlock Text=" &#9662;"/>
                    </StackPanel>
                </ToggleButton>
                <Popup x:Name="PopVergleich" PlacementTarget="{Binding ElementName=TglVergleich}" Placement="Bottom"
                       StaysOpen="False" IsOpen="{Binding IsChecked, ElementName=TglVergleich, Mode=TwoWay}"
                       Opened="Klappmenue_Opened" Closed="Klappmenue_Closed">
                    <Border Style="{StaticResource KlappRahmen}" PreviewKeyDown="Klappmenue_PreviewKeyDown">
                        <StackPanel>
                            <CheckBox x:Name="ChkVergleichsModus" Content="Vergleichsmodus (2 Lösungen)" Style="{StaticResource KlappEintrag}"
                                      Checked="ChkVergleichsModus_Changed" Unchecked="ChkVergleichsModus_Changed"/>
                            <CheckBox x:Name="ChkVmUnterschiede" Content="Unterschiede farbig"
                                      Margin="18,3,0,3" Visibility="Collapsed"
                                      ToolTip="Markiert Zeitslots, die in den beiden verglichenen Lösungen unterschiedlich belegt sind (Rahmen bzw. Fläche). Rahmenfarbe und -dicke sind im Farbcode-Dialog einstellbar."
                                      Checked="ChkVmUnterschiede_Changed" Unchecked="ChkVmUnterschiede_Changed"/>
                            <CheckBox x:Name="ChkVmPfeile" Content="Verschiebungspfeile"
                                      Margin="18,3,0,3" Visibility="Collapsed"
                                      ToolTip="Zeichnet im linken Plan (Lösung A) für jede päd. Einheit, die in beiden Lösungen vorkommt, aber verschoben wurde, einen Pfeil von ihrer A-Position zur Position in Lösung B (rechter Plan)."
                                      Checked="ChkVmPfeile_Changed" Unchecked="ChkVmPfeile_Changed"/>
                            <CheckBox x:Name="ChkVmNurAbw" Content="Nur Abw"
                                      Margin="18,3,0,3" Visibility="Collapsed"
                                      ToolTip="Beschränkt die Lehrer-/Klassen-Dropdowns im Vergleichsmodus auf die im Sheet „Abw“ genannten Lehrer und Klassen."
                                      Checked="ChkVmNurAbw_Changed" Unchecked="ChkVmNurAbw_Changed"/>
                        </StackPanel>
                    </Border>
                </Popup>
                <TextBlock x:Name="LblVglLoesung" Text="2. Lösung:" FontWeight="Bold" VerticalAlignment="Center"
                           Margin="6,0,6,0" Visibility="Collapsed"/>
                <Button x:Name="BtnVorigeVglLoesung2" Content="&#9664;" Width="28" VerticalAlignment="Center"
                        Margin="0,0,2,0" ToolTip="Vorige 2. Lösung" Click="BtnVorigeVglLoesung2_Click" Visibility="Collapsed"/>
                <ComboBox x:Name="CboVglLoesung2" Width="150" VerticalAlignment="Center" Margin="0,0,2,0"
                          SelectionChanged="CboVglLoesung2_SelectionChanged" Visibility="Collapsed"/>
                <Button x:Name="BtnNaechsteVglLoesung2" Content="&#9654;" Width="28" VerticalAlignment="Center"
                        ToolTip="Nächste 2. Lösung" Click="BtnNaechsteVglLoesung2_Click" Visibility="Collapsed"/>
            </StackPanel>

            <!-- Werkzeuge rechts: bleiben bei jeder Fensterbreite am rechten Rand. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                <Button x:Name="BtnDiagWerte" Content="Diag-Werte" VerticalAlignment="Center" Margin="0,0,6,0"
                        Padding="8,2" ToolTip="Diag-Zeile des aktuellen Lehrers (und Summe) in eigenem Fenster anzeigen"
                        Click="BtnDiagWerte_Click"/>
                <Button x:Name="BtnUvZeigen" Content="UV anzeigen" VerticalAlignment="Center" Margin="0,0,6,0"
                        Padding="8,2" ToolTip="UV-Zeilen des aktuellen Lehrers/der aktuellen Klasse in eigenem Fenster anzeigen (nur lesend). Mehrfach klickbar — jedes Fenster behaelt seinen Filter."
                        Click="BtnUvZeigen_Click"/>
                <ToggleButton x:Name="TglHinweise" Content="?" Width="28" FontWeight="Bold" VerticalAlignment="Center"
                              ToolTip="Hinweise zur Bedienung ein- und ausblenden"
                              Checked="TglHinweise_Changed" Unchecked="TglHinweise_Changed"/>
            </StackPanel>
        </Grid>

        <!-- Hinweise zur Bedienung: mit „?" ein-/ausklappbar, Zustand in EdCfg (HinweiseZeigen). -->
        <TextBlock x:Name="TxtHinweise" DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="#555"
                   Visibility="Collapsed">
            <Run Text="Links Lehrerplan, rechts Klassenplan. Klick auf eine Zelle zeigt im anderen Plan die zugehoerige Klasse bzw. den Lehrer. Ziehen: leere Zelle = verschieben, belegte Zelle gleicher Stundenzahl = tauschen, Parkbereich = entplanen. Ressourcenkonflikte werden hart gesperrt; Qualitaetsprobleme gelb gewarnt."/>
            <LineBreak/>
            <Run FontWeight="SemiBold" Foreground="#333"
                 Text="Rechtsklick auf eine Stunde (nur im Modus &quot;Einzelstunde&quot;): fixieren bzw. Fixierung entfernen. Das wird sofort in die Tabelle &quot;Fix UNrn&quot; und in die UV-Spalte &quot;Fix (X)&quot; geschrieben; die Excel-Datei wird nach dem Schliessen des Editors automatisch neu eingelesen. Mit &quot;Räume zeigen&quot; zusaetzlich: Raum ändern. Verschobene Stunden bekommen erst mit &quot;Räume verteilen&quot; einen Raum; gespeichert wird mit &quot;Räume speichern&quot; bzw. &quot;Uebernehmen&quot;."/>
        </TextBlock>

    <Grid>
        <!-- ZOOM: skaliert das gesamte Wurzel-Grid (Zellen, Schrift, Park- und
             Detailbereich) gleichmaessig. ScaleX/Y werden ausschliesslich in
             SetzeZoom() im Code-Behind gesetzt, nie hier fest — sonst laufen
             Buttons, Strg+Mausrad und der in EdCfg gemerkte Wert auseinander.
             Die Fenstergroesse bleibt bewusst unberuehrt (die wird separat in
             EdCfg gesichert); da die Zeilen Star-Hoehen haben, bekommt das Grid
             bei kleinerem Zoom automatisch mehr logischen Platz — es wird also
             nichts abgeschnitten, es passt schlicht mehr Plan ins Fenster. -->
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <!-- Zeilen 0 und 1 sind seit dem Umbau der Kopfleiste leer (Kopfleiste und Hinweise
                 stehen oberhalb dieses Grids und zoomen nicht mit); sie bleiben stehen, damit
                 die Zeilennummern unten unverändert gelten. -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*" MinHeight="240" x:Name="RowPlaene"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="0.8*" MinHeight="70" x:Name="RowDetail"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Hauptbereich: Lehrerplan | Klassenplan | Vergleich-Vorher | Vergleich-Nachher | KlVgl-Vorher | KlVgl-Nachher -->
        <!-- Stundenplan UND Parkbereich gemeinsam in RowPlaene. Der Splitter
             darunter zieht damit direkt RowPlaene gegen RowDetail. -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="150"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="140" MinHeight="70" x:Name="RowPark"/>
            </Grid.RowDefinitions>

        <ScrollViewer x:Name="ScrollEditAnsicht" Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ANGEHEFTETE PLAENE (beliebig viele Lehrer-/Klassenpläne
                 zusätzlich zur normalen Auswahl oben, nebeneinander scrollbar
                 über ScrollEditAnsicht, alle live editierbar auf derselben
                 _belegung — siehe AnhefteTile()/ZeichneAlleAngehefteten(). -->
            <StackPanel x:Name="PnlAngeheftet" Grid.Column="9" Orientation="Horizontal"/>

            <!-- RAUM-PLAN (R2, reine Ansicht, siehe ZeichneRaumplanGrid in
                 PlanEditorDialog_Raeume.cs): je Zeitslot der Unterricht im gewaehlten
                 Raum, nach der live verteilten Raumbelegung der Arbeitskopie. -->
            <Border Grid.Column="8" x:Name="BrdRaumPlan" BorderBrush="#CCC" BorderThickness="1"
                    Margin="4,0,4,0" Background="#FBFBFB" Visibility="Collapsed">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4" Height="32">
                        <TextBlock Text="Raum:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button x:Name="BtnVorigerRaum" Content="&#9664;" Width="28" VerticalAlignment="Center"
                                Margin="0,0,2,0" ToolTip="Voriger Raum" Click="BtnVorigerRaum_Click"/>
                        <ComboBox x:Name="CboRaum" Width="140" VerticalAlignment="Center" Margin="0,0,2,0"
                                  SelectionChanged="CboRaum_SelectionChanged"/>
                        <Button x:Name="BtnNaechsterRaum" Content="&#9654;" Width="28" VerticalAlignment="Center"
                                ToolTip="Naechster Raum" Click="BtnNaechsterRaum_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="LblRaumplanKopf" DockPanel.Dock="Top" Text="RAUMPLAN"
                               FontWeight="Bold" Height="20"
                               HorizontalAlignment="Center" Margin="0,0,0,2"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="RaumplanGrid"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- FACHGRUPPEN-PLAN (reine Ansicht, siehe ZeichneEinFachgruppenGrid).
                 Zeigt je Zeitslot ALLE Bloecke, die einen Raum der gewaehlten
                 Fachgruppe belegen, plus das Auslastungs-Badge belegt/Limit
                 (Limit = Spalte B im Sheet FGR). Kein Drop-Ziel, keine
                 Tauschliste: entzerrt wird im Lehrer-/Klassenplan, auf den
                 ein Klick hier umstellt. -->
            <Border Grid.Column="6" x:Name="BrdFachgruppenPlan" BorderBrush="#CCC" BorderThickness="1"
                    Margin="4,0,4,0" Background="#FBFBFB" Visibility="Collapsed">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4" Height="32">
                        <TextBlock Text="Fachgruppe:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button x:Name="BtnVorigeFachgruppe" Content="&#9664;" Width="28" VerticalAlignment="Center"
                                Margin="0,0,2,0" ToolTip="Vorige Fachgruppe" Click="BtnVorigeFachgruppe_Click"/>
                        <ComboBox x:Name="CboFachgruppe" Width="140" VerticalAlignment="Center" Margin="0,0,2,0"
                                  SelectionChanged="CboFachgruppe_SelectionChanged"/>
                        <Button x:Name="BtnNaechsteFachgruppe" Content="&#9654;" Width="28" VerticalAlignment="Center"
                                ToolTip="Naechste Fachgruppe" Click="BtnNaechsteFachgruppe_Click"/>
                        <Button x:Name="BtnFachgruppeAnheften" Content="📌" Width="28" VerticalAlignment="Center"
                                Margin="8,0,0,0"
                                ToolTip="Diesen Fachgruppenplan zusätzlich anheften (bleibt sichtbar, auch wenn oben eine andere Fachgruppe gewählt wird)"
                                Click="BtnFachgruppeAnheften_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="LblFachgruppenKopf" DockPanel.Dock="Top" Text="FACHGRUPPENPLAN"
                               FontWeight="Bold" Height="20"
                               HorizontalAlignment="Center" Margin="0,0,0,2"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="FachgruppenGrid"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- FAECHER-PLAN (reine Ansicht, siehe ZeichneEinAnsichtGrid mit
                 _schlFach). Wie der Fachgruppenplan aufgebaut, gruppiert aber
                 nach dem einzelnen Fach (t.Fach) statt der Raum-Fachgruppe. Es
                 gibt kein Raumlimit; das Badge ist ein reiner Parallelitaets-
                 Zaehler (belegt N, ohne "/Limit"), immer neutral gefaerbt. Klick
                 auf einen Unterricht stellt Lehrer- und Klassenplan darauf um. -->
            <Border Grid.Column="7" x:Name="BrdFaecherPlan" BorderBrush="#CCC" BorderThickness="1"
                    Margin="4,0,4,0" Background="#FBFBFB" Visibility="Collapsed">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4" Height="32">
                        <TextBlock Text="Fach:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button x:Name="BtnVorigesFach" Content="&#9664;" Width="28" VerticalAlignment="Center"
                                Margin="0,0,2,0" ToolTip="Voriges Fach" Click="BtnVorigesFach_Click"/>
                        <ComboBox x:Name="CboFach" Width="140" VerticalAlignment="Center" Margin="0,0,2,0"
                                  SelectionChanged="CboFach_SelectionChanged"/>
                        <Button x:Name="BtnNaechstesFach" Content="&#9654;" Width="28" VerticalAlignment="Center"
                                ToolTip="Naechstes Fach" Click="BtnNaechstesFach_Click"/>
                        <Button x:Name="BtnFachAnheften" Content="📌" Width="28" VerticalAlignment="Center"
                                Margin="8,0,0,0"
                                ToolTip="Diesen Faecherplan zusätzlich anheften (bleibt sichtbar, auch wenn oben ein anderes Fach gewählt wird)"
                                Click="BtnFachAnheften_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="LblFaecherKopf" DockPanel.Dock="Top" Text="FAECHERPLAN"
                               FontWeight="Bold" Height="20"
                               HorizontalAlignment="Center" Margin="0,0,0,2"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="FaecherGrid"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- LEHRER-PLAN -->
            <Border Grid.Column="0" BorderBrush="#CCC" BorderThickness="1" Margin="0,0,4,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4" Height="32">
                        <TextBlock Text="Lehrer:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button x:Name="BtnVorigerLehrer" Content="&#9664;" Width="28" VerticalAlignment="Center"
                                Margin="0,0,2,0" ToolTip="Voriger Lehrer" Click="BtnVorigerLehrer_Click"/>
                        <ComboBox x:Name="CboLehrer" Width="140" VerticalAlignment="Center" Margin="0,0,2,0"
                                  SelectionChanged="CboLehrer_SelectionChanged"/>
                        <Button x:Name="BtnNaechsterLehrer" Content="&#9654;" Width="28" VerticalAlignment="Center"
                                ToolTip="Naechster Lehrer" Click="BtnNaechsterLehrer_Click"/>
                        <Button x:Name="BtnDiagFilter" Content="Diag-Filter" VerticalAlignment="Center"
                                Margin="8,0,0,0" Padding="6,2"
                                ToolTip="Lehrer-Auswahlliste auf Lehrer beschränken, die bestimmte Diag-Kriterien verletzen"
                                Click="BtnDiagFilter_Click"/>
                        <Button x:Name="BtnLehrerAnheften" Content="📌" Width="28" VerticalAlignment="Center"
                                Margin="8,0,0,0"
                                ToolTip="Diesen Lehrerplan zusätzlich anheften (bleibt sichtbar und bearbeitbar, auch wenn oben ein anderer Lehrer gewählt wird)"
                                Click="BtnLehrerAnheften_Click"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="LEHRERPLAN" FontWeight="Bold" Height="20"
                               HorizontalAlignment="Center" Margin="0,0,0,2"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid x:Name="LehrerGrid"/>
                            <Canvas x:Name="LehrerCanvas" IsHitTestVisible="False"/>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- KLASSEN-PLAN -->
            <Border Grid.Column="1" BorderBrush="#CCC" BorderThickness="1" Margin="4,0,4,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4" Height="32">
                        <TextBlock Text="Klasse:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button x:Name="BtnVorigeKlasse" Content="&#9664;" Width="28" VerticalAlignment="Center"
                                Margin="0,0,2,0" ToolTip="Vorige Klasse" Click="BtnVorigeKlasse_Click"/>
                        <ComboBox x:Name="CboKlasse" Width="140" VerticalAlignment="Center" Margin="0,0,2,0"
                                  SelectionChanged="CboKlasse_SelectionChanged"/>
                        <Button x:Name="BtnNaechsteKlasse" Content="&#9654;" Width="28" VerticalAlignment="Center"
                                ToolTip="Naechste Klasse" Click="BtnNaechsteKlasse_Click"/>
                        <Button x:Name="BtnKlasseAnheften" Content="📌" Width="28" VerticalAlignment="Center"
                                Margin="8,0,0,0"
                                ToolTip="Diesen Klassenplan zusätzlich anheften (bleibt sichtbar und bearbeitbar, auch wenn oben eine andere Klasse gewählt wird)"
                                Click="BtnKlasseAnheften_Click"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="KLASSENPLAN" FontWeight="Bold" Height="20"
                               HorizontalAlignment="Center" Margin="0,0,0,2"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid x:Name="KlasseGrid"/>
                            <Canvas x:Name="KlasseCanvas" IsHitTestVisible="False"/>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- VERGLEICH VORHER -->
            <Border Grid.Column="2" x:Name="BrdVglVorher" BorderBrush="#CCC" BorderThickness="1"
                    Margin="4,0,4,0" Background="#FBFBFB" Visibility="Collapsed">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4" Height="32">
                        <TextBlock Text="Vgl.-Lehrer:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button x:Name="BtnVorigerVglLehrer" Content="&#9664;" Width="28" VerticalAlignment="Center"
                                Margin="0,0,2,0" Click="BtnVorigerVglLehrer_Click"/>
                        <ComboBox x:Name="CboVglLehrer" Width="120" VerticalAlignment="Center" Margin="0,0,2,0"
                                  SelectionChanged="CboVglLehrer_SelectionChanged"/>
                        <Button x:Name="BtnNaechsterVglLehrer" Content="&#9654;" Width="28" VerticalAlignment="Center"
                                Click="BtnNaechsterVglLehrer_Click"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="VORHER" FontWeight="Bold" Height="20"
                               HorizontalAlignment="Center" Margin="0,0,0,2"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid x:Name="GridVglVorher"/>
                            <Canvas x:Name="VglVorherCanvas" IsHitTestVisible="False"/>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- VERGLEICH NACHHER -->
            <Border Grid.Column="3" x:Name="BrdVglNachher" BorderBrush="#CCC" BorderThickness="1"
                    Margin="4,0,4,0" Background="#FBFBFB" Visibility="Collapsed">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Height="32" Margin="4"/>
                    <TextBlock DockPanel.Dock="Top" Text="NACHHER" FontWeight="Bold" Height="20"
                               HorizontalAlignment="Center" Margin="0,0,0,2"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="GridVglNachher"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- KLASSEN-VERGLEICH VORHER -->
            <Border Grid.Column="4" x:Name="BrdVglKlasseVorher" BorderBrush="#CCC" BorderThickness="1"
                    Margin="4,0,4,0" Background="#FBFBFB" Visibility="Collapsed">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4" Height="32">
                        <TextBlock Text="Vgl.-Klasse:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button x:Name="BtnVorigeVglKlasse" Content="&#9664;" Width="28" VerticalAlignment="Center"
                                Margin="0,0,2,0" Click="BtnVorigeVglKlasse_Click"/>
                        <ComboBox x:Name="CboVglKlasse" Width="120" VerticalAlignment="Center" Margin="0,0,2,0"
                                  SelectionChanged="CboVglKlasse_SelectionChanged"/>
                        <Button x:Name="BtnNaechsteVglKlasse" Content="&#9654;" Width="28" VerticalAlignment="Center"
                                Click="BtnNaechsteVglKlasse_Click"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="VORHER (Klasse)" FontWeight="Bold" Height="20"
                               HorizontalAlignment="Center" Margin="0,0,0,2"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid x:Name="GridVglKlasseVorher"/>
                            <Canvas x:Name="VglKlasseVorherCanvas" IsHitTestVisible="False"/>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- KLASSEN-VERGLEICH NACHHER -->
            <Border Grid.Column="5" x:Name="BrdVglKlasseNachher" BorderBrush="#CCC" BorderThickness="1"
                    Margin="4,0,0,0" Background="#FBFBFB" Visibility="Collapsed">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Height="32" Margin="4"/>
                    <TextBlock DockPanel.Dock="Top" Text="NACHHER (Klasse)" FontWeight="Bold" Height="20"
                               HorizontalAlignment="Center" Margin="0,0,0,2"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="GridVglKlasseNachher"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
        </ScrollViewer>

        <!-- VERGLEICHSMODUS: 1x4 (Lehrer A | Lehrer B | Klasse A | Klasse B nebeneinander) -->
        <ScrollViewer x:Name="ScrollVergleichsModus" Grid.Row="0" Visibility="Collapsed"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      HorizontalAlignment="Left">
        <DockPanel>
            <!-- Eigene Lehrer/Klasse-Navigationsleiste (die Dropdowns der Editieransicht
                 sind im Vergleichsmodus ausgeblendet und daher nicht erreichbar) -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4" Height="32">
                <TextBlock Text="Lehrer:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Button x:Name="BtnVmVorigerLehrer" Content="&#9664;" Width="28" VerticalAlignment="Center"
                        Margin="0,0,2,0" ToolTip="Voriger Lehrer" Click="BtnVorigerLehrer_Click"/>
                <ComboBox x:Name="CboVmLehrer" Width="140" VerticalAlignment="Center" Margin="0,0,2,0"
                          SelectionChanged="CboVmLehrer_SelectionChanged"/>
                <Button x:Name="BtnVmNaechsterLehrer" Content="&#9654;" Width="28" VerticalAlignment="Center"
                        Margin="0,0,24,0" ToolTip="Naechster Lehrer" Click="BtnNaechsterLehrer_Click"/>

                <TextBlock Text="Klasse:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Button x:Name="BtnVmVorigeKlasse" Content="&#9664;" Width="28" VerticalAlignment="Center"
                        Margin="0,0,2,0" ToolTip="Vorige Klasse" Click="BtnVorigeKlasse_Click"/>
                <ComboBox x:Name="CboVmKlasse" Width="140" VerticalAlignment="Center" Margin="0,0,2,0"
                          SelectionChanged="CboVmKlasse_SelectionChanged"/>
                <Button x:Name="BtnVmNaechsteKlasse" Content="&#9654;" Width="28" VerticalAlignment="Center"
                        ToolTip="Naechste Klasse" Click="BtnNaechsteKlasse_Click"/>
            </StackPanel>

        <Grid x:Name="GridVergleichsModus">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Lehrer Lösung A -->
            <Border Grid.Column="0" BorderBrush="#CCC" BorderThickness="1" Margin="0,0,2,0">
                <DockPanel>
                    <TextBlock x:Name="LblVmLehrerA" DockPanel.Dock="Top" Text="LEHRER – Lösung A"
                               FontWeight="Bold" Height="20" HorizontalAlignment="Center" Margin="0,2,0,2"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid x:Name="VmLehrerGridA"/>
                            <Canvas x:Name="VmLehrerACanvas" IsHitTestVisible="False"/>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Lehrer Lösung B -->
            <Border Grid.Column="1" BorderBrush="#CCC" BorderThickness="1" Margin="2,0,2,0" Background="#FBFBFB">
                <DockPanel>
                    <TextBlock x:Name="LblVmLehrerB" DockPanel.Dock="Top" Text="LEHRER – Lösung B"
                               FontWeight="Bold" Height="20" HorizontalAlignment="Center" Margin="0,2,0,2"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="VmLehrerGridB"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Klasse Lösung A -->
            <Border Grid.Column="2" BorderBrush="#CCC" BorderThickness="1" Margin="8,0,2,0">
                <DockPanel>
                    <TextBlock x:Name="LblVmKlasseA" DockPanel.Dock="Top" Text="KLASSE – Lösung A"
                               FontWeight="Bold" Height="20" HorizontalAlignment="Center" Margin="0,2,0,2"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid x:Name="VmKlasseGridA"/>
                            <Canvas x:Name="VmKlasseACanvas" IsHitTestVisible="False"/>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Klasse Lösung B -->
            <Border Grid.Column="3" BorderBrush="#CCC" BorderThickness="1" Margin="2,0,0,0" Background="#FBFBFB">
                <DockPanel>
                    <TextBlock x:Name="LblVmKlasseB" DockPanel.Dock="Top" Text="KLASSE – Lösung B"
                               FontWeight="Bold" Height="20" HorizontalAlignment="Center" Margin="0,2,0,2"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="VmKlasseGridB"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
        </DockPanel>
        </ScrollViewer>

        <!-- Verschiebbarer Trenner: Plaene <-> Parkbereich -->
        <GridSplitter x:Name="SplitterPark" Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                      VerticalAlignment="Center" Background="#999"
                      ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"/>

        <!-- Parkbereich (waagerecht unter den Plaenen), Hoehe ueber RowPark/Splitter verstellbar -->
        <Border x:Name="BrdParkbereich" Grid.Row="2" BorderBrush="#CCC" BorderThickness="1" Margin="0,4,0,0"
                Background="#FAFAFA" AllowDrop="True" Drop="Parkbereich_Drop" DragOver="Zelle_DragOver">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,4,6,2">
                    <TextBlock Text="Parkbereich (nicht verplant) - hierher ziehen zum Entplanen"
                               FontWeight="Bold" VerticalAlignment="Center"/>
                    <CheckBox x:Name="ChkIgnorierteZeigen" Content="Ignorierte anzeigen"
                              VerticalAlignment="Center" Margin="20,0,0,0"
                              Checked="ChkIgnorierteZeigen_Changed" Unchecked="ChkIgnorierteZeigen_Changed"/>
                </StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="ParkPanel" Orientation="Horizontal" Margin="4"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
        </Grid>

        <!-- Verschiebbarer Trenner: Stundenplan+Parkbereich <-> Diagnose.
             Resized RowPlaene (Row 2) gegen RowDetail (Row 4): nach unten ziehen
             vergrößert die Pläne, nach oben den Detailbereich. -->
        <GridSplitter x:Name="SplitterDetail" Grid.Row="3" Height="6" HorizontalAlignment="Stretch"
                      VerticalAlignment="Center" Background="#999"
                      ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"
                      Margin="0,4,0,0" Cursor="SizeNS"/>

        <!-- Detail-Bereich: links Tauschliste, daneben Verschiebung, daneben Details/Diagnose.
             Spalten sind über GridSplitter verschiebbar; Min-Breiten verhindern Verschwinden. -->
        <Border x:Name="BrdDetailBereich" Grid.Row="4" BorderBrush="#DDD" BorderThickness="1" Margin="0,8,0,0" Padding="6"
                Background="#F7F7F7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" MinWidth="60"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220" MinWidth="60"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="120"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="#EEE" BorderThickness="0,0,1,0" Padding="0,0,6,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Tauschvorschlaege:" FontWeight="Bold" Margin="0,0,0,4"/>
                        <CheckBox DockPanel.Dock="Top" x:Name="ChkFilterVerletzungen" Margin="0,0,0,4"
                                  Checked="ChkFilterVerletzungen_Changed" Unchecked="ChkFilterVerletzungen_Changed"
                                  ToolTip="Gilt für beide Listen (Tauschvorschläge und Verschiebung mit Ausweich): blendet Vorschläge aus, die gegenüber dem aktuellen Plan eine neue Tagesregel-Verletzung erzeugen oder einem Lehrer einen geforderten freien Tag nehmen würden. Bereits vorher bestehende Verletzungen filtern nicht.">
                            <TextBlock Text="ohne Tagesregel-/Freie-Tage-Verletzungen (beide Listen)" TextWrapping="Wrap" FontSize="11"/>
                        </CheckBox>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="PnlTausch"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center"
                              VerticalAlignment="Stretch" Background="#CCC"
                              ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Cursor="SizeWE"/>

                <Border Grid.Column="2" BorderBrush="#EEE" BorderThickness="0,0,1,0" Padding="6,0,6,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Verschiebung mit Ausweich:" FontWeight="Bold" Margin="0,0,0,4"/>
                        <!-- Standardmäßig AUS: die Suche läuft bei jeder überfahrenen
                             Zelle neu und ist der mit Abstand teuerste Teil des
                             Drag&Drop (siehe SucheVerschiebungMitAusweich) — beim
                             blossen Ziehen ohne Bedarf an Vorschlägen macht sie den
                             Editor spürbar träge. -->
                        <CheckBox DockPanel.Dock="Top" x:Name="ChkAusweichSuche" Margin="0,0,0,4"
                                  Checked="ChkAusweichSuche_Changed" Unchecked="ChkAusweichSuche_Changed"
                                  ToolTip="Sucht beim Ziehen live nach Wegen, den Unterricht auf ein belegtes Feld zu bekommen, indem die Hindernis-Blöcke klassenintern ausweichen. Rechenintensiv: läuft bei jeder überfahrenen Zelle neu. Abgeschaltet bleibt das Ziehen flüssig, die roten und gelben Warnungen am Zielfeld kommen weiterhin.">
                            <TextBlock Text="Ausweichsuche beim Ziehen (rechenintensiv)" TextWrapping="Wrap" FontSize="11"/>
                        </CheckBox>
                        <CheckBox DockPanel.Dock="Top" x:Name="ChkAusweichTiefe3" Margin="12,0,0,4"
                                  Checked="ChkAusweichTiefe3_Changed" Unchecked="ChkAusweichTiefe3_Changed"
                                  ToolTip="Erweitert die Ausweichsuche auf drei Klassen: Blockiert der Ausweich-Tausch in der 2. Klasse selbst einen Lehrer in einer 3. Klasse, wird auch dort getauscht. Deutlich rechenintensiver - nur zuschalten, wenn nötig. Wirkt nur bei aktiver Ausweichsuche.">
                            <TextBlock Text="…auch über 3 Klassen (noch rechenintensiver)" TextWrapping="Wrap" FontSize="11"/>
                        </CheckBox>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="PnlVerschieb"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Center"
                              VerticalAlignment="Stretch" Background="#CCC"
                              ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Cursor="SizeWE"/>

                <DockPanel Grid.Column="4" Margin="6,0,0,0">
                    <TextBlock DockPanel.Dock="Top" Text="Details / Diagnose:" FontWeight="Bold" Margin="0,0,0,4"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TxtDetails" TextWrapping="Wrap" Text="(noch keine Auswahl)" FontFamily="Consolas" FontSize="16.5"/>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>

        <!-- Statuszeile + Buttons (linksbuendig) -->
        <Grid Grid.Row="5" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnReset"       Content="Zuruecksetzen" Width="120" Margin="0,0,6,0" Click="BtnReset_Click"/>
                <Button x:Name="BtnUebernehmen" Content="Uebernehmen"   Width="180" Margin="0,0,6,0" Click="BtnUebernehmen_Click"/>
                <Button x:Name="BtnSchliessen"  Content="Schliessen"    Width="100" Margin="0,0,20,0" Click="BtnSchliessen_Click"/>
                <Button x:Name="BtnRaeumeVerteilen" Content="Räume verteilen" Padding="10,0" Margin="0,0,6,0"
                        Visibility="Collapsed" Click="BtnRaeumeVerteilen_Click"
                        ToolTip="Gibt den offenen (verschobenen) Stunden einen freien Raum – wie Knopf 25 „Behalten und ergänzen“. Alle übrigen Räume bleiben, wie sie sind. Gibt es für die Lösung noch keine Räume: Vorschlag für die ganze Lösung. Gespeichert wird erst mit „Räume speichern“ bzw. „Uebernehmen“."/>
                <Button x:Name="BtnRaeumeSpeichern" Content="Räume speichern" Padding="10,0" Margin="0,0,20,0"
                        Visibility="Collapsed" Click="BtnRaeumeSpeichern_Click"
                        ToolTip="Schreibt die Räume dieser Lösung (inkl. der Änderungen von Hand) ins Blatt „Raumplan“. Nur solange keine Stunde verschoben wurde – sonst werden die Räume mit „Uebernehmen“ für die neue Lösung gespeichert (nur mit eingeschalteter Raum-Ansicht)."/>

                <!-- Zoom-Bedienung. Der eigentliche Effekt haengt am
                     ZoomTransform des Wurzel-Grids (siehe oben) und wird in
                     SetzeZoom() gesetzt; der Wert wird in EdCfg gemerkt. -->
                <TextBlock Text="Zoom:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Button x:Name="BtnZoomMinus" Content="&#8722;" Width="28" Margin="0,0,2,0"
                        ToolTip="Ansicht verkleinern (auch Strg + Mausrad nach unten)"
                        Click="BtnZoomMinus_Click"/>
                <TextBlock x:Name="TxtZoomWert" Text="100%" Width="46" TextAlignment="Center"
                           VerticalAlignment="Center"/>
                <Button x:Name="BtnZoomPlus" Content="+" Width="28" Margin="2,0,6,0"
                        ToolTip="Ansicht vergroessern (auch Strg + Mausrad nach oben)"
                        Click="BtnZoomPlus_Click"/>
                <Button x:Name="BtnZoomReset" Content="100%" Width="52" Margin="0,0,20,0"
                        ToolTip="Zoom auf 100 % zuruecksetzen"
                        Click="BtnZoomReset_Click"/>

                <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" Text="Bereit." FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>
    </Grid>
    </DockPanel>
</Window>
