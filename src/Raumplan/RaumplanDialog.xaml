<Window x:Class="Stundenplan_V2.Raumplanung.RaumplanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Räume zuweisen (Raumplan)"
        Width="1120" Height="740"
        MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <!-- Knopf 25 (Schritt R1): Räume für eine Plan-Spalte verteilen, Vorschau, Speichern ins Blatt „Raumplan“. -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="DimGray"
                   Text="Weist den Unterrichten der gewählten Plan-Spalte Räume zu: zuerst der Fachraum laut UV (bei „A~B“ alle genannten Räume), sonst ein anderer Raum derselben Fachgruppe, der Stammraum laut UV oder ein freier Ausweichraum. Schwimmbäder (Sonderräume) werden nie ersetzt. Erst „Speichern“ schreibt das Ergebnis ins Blatt „Raumplan“ der Plandatei – die Datei darf dabei nicht in Excel geöffnet sein."/>

        <WrapPanel Grid.Row="1" Margin="0,0,0,6">
            <TextBlock Text="Plan:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="CbPlan" Width="130" VerticalAlignment="Center" Margin="0,0,18,0"
                      SelectionChanged="CbPlan_SelectionChanged"/>
            <RadioButton x:Name="RbBehalten" GroupName="Modus" Content="Behalten und ergänzen" VerticalAlignment="Center"
                         Margin="0,0,12,0" Checked="Modus_Checked"
                         ToolTip="Vorhandene Zuweisungen bleiben; nur neue oder verschobene Stunden bekommen einen Raum."/>
            <RadioButton x:Name="RbNeu" GroupName="Modus" Content="Neu verteilen" VerticalAlignment="Center"
                         Margin="0,0,18,0" Checked="Modus_Checked"
                         ToolTip="Alle Räume werden neu verteilt. Zeilen mit Fix (X) im Blatt „Raumplan“ bleiben immer."/>
            <Button x:Name="BtnBerechnen" Content="Vorschau neu berechnen" Padding="12,3" Click="BtnBerechnen_Click"/>
        </WrapPanel>

        <Border Grid.Row="2" x:Name="BrdStand" Background="#EEEEEE" Padding="8,4" Margin="0,0,0,8" CornerRadius="3">
            <TextBlock x:Name="TxtStand" TextWrapping="Wrap" Text="Lese die Plandatei …"/>
        </Border>

        <TabControl Grid.Row="3" x:Name="Tabs">
            <TabItem Header="Übersicht">
                <DataGrid x:Name="DgZahlen" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          CanUserAddRows="False" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Bereich" Binding="{Binding Bereich}" Width="170"/>
                        <DataGridTextColumn Header="Angabe" Binding="{Binding Angabe}" Width="440"/>
                        <DataGridTextColumn Header="Wert" Binding="{Binding Wert}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <TextBlock x:Name="TxtZeilenKopf" Text="Zuweisungen"/>
                </TabItem.Header>
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,4,0,4">
                        <CheckBox x:Name="ChkNurPruef" Content="nur Ausweich und Probleme" IsChecked="True" Margin="0,0,18,0"
                                  VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                        <TextBlock Text="Suchen:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="TxtFilter" Width="180" VerticalAlignment="Center" TextChanged="TxtFilter_TextChanged"
                                 ToolTip="Raum, Klasse, Lehrkraft, Fach, UNr oder Tag"/>
                        <TextBlock x:Name="TxtTreffer" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="DimGray"/>
                    </WrapPanel>
                    <DataGrid x:Name="DgZeilen" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              CanUserAddRows="False" GridLinesVisibility="Horizontal" EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tag" Binding="{Binding WTag}" Width="40"/>
                            <DataGridTextColumn Header="Std" Binding="{Binding Stunde}" Width="38"/>
                            <DataGridTextColumn Header="UNr" Binding="{Binding UNr}" Width="50"/>
                            <DataGridTextColumn Header="Lehrer" Binding="{Binding Lehrer}" Width="62"/>
                            <DataGridTextColumn Header="Fach" Binding="{Binding Fach}" Width="70"/>
                            <DataGridTextColumn Header="Klasse(n)" Binding="{Binding Klassen}" Width="110"/>
                            <DataGridTextColumn Header="Raum" Binding="{Binding Raum}" Width="62" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Wunschraum" Binding="{Binding Wunschraum}" Width="80"/>
                            <DataGridTextColumn Header="Herkunft" Binding="{Binding Herkunft}" Width="85"/>
                            <DataGridTextColumn Header="Fix" Binding="{Binding FixText}" Width="30"/>
                            <DataGridTemplateColumn Header="Hinweis" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Hinweis}" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <TextBlock x:Name="TxtRaeumeKopf" Text="Räume"/>
                </TabItem.Header>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,4,0,6" Foreground="DimGray"
                               Text="So werden die Räume behandelt. Ändern in Excel im Blatt „Räume“: Art (Klassenraum, Kursraum, Fachraum, Sonderraum), Fachgruppe (wie im Blatt FGR), „als Ausweich“ (x = darf als freier Ausweichraum genommen werden), Bereich (Ausweichräume aus demselben Bereich zuerst). Die Reihenfolge der Zeilen ist die Reihenfolge beim Ausweichen. Sonderräume (z. B. Schwimmbad) werden nie ersetzt und nie als Ausweich genommen."/>
                    <DataGrid x:Name="DgRaeume" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              CanUserAddRows="False" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Raum" Binding="{Binding Name}" Width="80"/>
                            <DataGridTextColumn Header="Art" Binding="{Binding ArtText}" Width="95"/>
                            <DataGridTextColumn Header="Fachgruppe" Binding="{Binding Fachgruppe}" Width="95"/>
                            <DataGridTextColumn Header="als Ausweich" Binding="{Binding AusweichText}" Width="80"/>
                            <DataGridTextColumn Header="Bereich" Binding="{Binding Bereich}" Width="100"/>
                            <DataGridTextColumn Header="Quelle" Binding="{Binding QuelleText}" Width="110"/>
                            <DataGridTextColumn Header="Bemerkung" Binding="{Binding Bemerkung}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <TextBlock x:Name="TxtHinweiseKopf" Text="Hinweise"/>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TxtHinweise" TextWrapping="Wrap" Margin="8" LineHeight="20"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="4" Margin="0,10,0,0" LastChildFill="True">
            <Button DockPanel.Dock="Left" x:Name="BtnRaeume" Content="Blatt „Räume“ anlegen" Padding="10,3"
                    Margin="0,0,12,0" Click="BtnRaeume_Click" IsEnabled="False"/>
            <Button DockPanel.Dock="Right" x:Name="BtnSchliessen" Content="Schließen" Width="110" IsCancel="True"
                    Click="BtnSchliessen_Click"/>
            <Button DockPanel.Dock="Right" x:Name="BtnSpeichern" Content="Speichern" Width="110" Margin="0,0,8,0"
                    Click="BtnSpeichern_Click" IsEnabled="False"/>
            <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" Foreground="DimGray" TextTrimming="CharacterEllipsis"
                       Margin="0,0,12,0"/>
        </DockPanel>
    </Grid>
</Window>
