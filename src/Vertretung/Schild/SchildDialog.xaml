<Window x:Class="Stundenplan_V2.Vertretung.SchildDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SchILD-Daten prüfen"
        Width="1040" Height="720"
        MinWidth="780" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <!-- Phase 5.2a-1: Prüflauf eines SchILD-NRW-3-Exports (nur lesen, nichts senden) und Pseudo-Export. -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="DimGray"
                   Text="Prüft einen Export aus SchILD-NRW 3 (Textdateien .dat). Die Dateien werden nur auf diesem Rechner gelesen – es wird nichts gesendet und nichts gespeichert. Meldungen nennen bei Schülerdateien nur Datei, Zeile, Spalte und Grund."/>

        <DockPanel Grid.Row="1" Margin="0,0,0,6" LastChildFill="True">
            <TextBlock DockPanel.Dock="Left" Text="Ordner:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <Button DockPanel.Dock="Right" x:Name="BtnPruefen" Content="Prüflauf" Padding="14,3" Margin="6,0,0,0"
                    Click="BtnPruefen_Click"/>
            <Button DockPanel.Dock="Right" x:Name="BtnOrdner" Content="Ordner wählen…" Padding="10,3" Margin="6,0,0,0"
                    Click="BtnOrdner_Click"/>
            <TextBox x:Name="TxtOrdner" IsReadOnly="True" VerticalContentAlignment="Center"/>
        </DockPanel>

        <WrapPanel Grid.Row="2" Margin="0,0,0,8">
            <Border x:Name="BrdArt" Background="#EEEEEE" Padding="8,3" Margin="0,0,12,0" CornerRadius="3">
                <TextBlock x:Name="TxtArt" Text="Noch kein Ordner geprüft." TextWrapping="Wrap" MaxWidth="560"/>
            </Border>
            <TextBlock Text="Abschnitt:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="CbAbschnitt" Width="250" VerticalAlignment="Center" Margin="0,0,12,0"
                      DisplayMemberPath="Anzeige" SelectionChanged="CbAbschnitt_SelectionChanged"/>
            <TextBlock x:Name="TxtProfil" VerticalAlignment="Center" Foreground="DimGray"/>
        </WrapPanel>

        <TabControl Grid.Row="3" x:Name="Tabs">
            <TabItem Header="Übersicht">
                <DataGrid x:Name="DgZahlen" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          CanUserAddRows="False" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Bereich" Binding="{Binding Bereich}" Width="220"/>
                        <DataGridTextColumn Header="Angabe" Binding="{Binding Angabe}" Width="360"/>
                        <DataGridTextColumn Header="Wert" Binding="{Binding Wert}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <TextBlock x:Name="TxtProblemeKopf" Text="Probleme"/>
                </TabItem.Header>
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,4,0,4">
                        <TextBlock Text="Anzeigen:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <CheckBox x:Name="ChkFehler" Content="Fehler" IsChecked="True" Margin="0,0,12,0"
                                  VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                        <CheckBox x:Name="ChkWarnungen" Content="Warnungen" IsChecked="True" Margin="0,0,12,0"
                                  VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                        <CheckBox x:Name="ChkHinweise" Content="Hinweise" IsChecked="True"
                                  VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                    </WrapPanel>
                    <DataGrid x:Name="DgProbleme" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              CanUserAddRows="False" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Art" Binding="{Binding ArtText}" Width="75"/>
                            <DataGridTextColumn Header="Datei" Binding="{Binding Datei}" Width="200"/>
                            <DataGridTextColumn Header="Zeile" Binding="{Binding ZeileText}" Width="55"/>
                            <DataGridTextColumn Header="Spalte" Binding="{Binding Spalte}" Width="130"/>
                            <DataGridTemplateColumn Header="Grund" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Grund}" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Welche Dateien?">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TxtDateienHilfe" TextWrapping="Wrap" Margin="8" LineHeight="20"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="4" Margin="0,10,0,0" LastChildFill="True">
            <Button DockPanel.Dock="Left" x:Name="BtnPseudo" Content="Pseudo-Export erzeugen…" Padding="10,3"
                    Margin="0,0,6,0" Click="BtnPseudo_Click"/>
            <Button DockPanel.Dock="Left" x:Name="BtnProfil" Content="Formatprofil als Datei anlegen…" Padding="10,3"
                    Margin="0,0,6,0" Click="BtnProfil_Click"/>
            <Button DockPanel.Dock="Left" x:Name="BtnBericht" Content="Bericht kopieren" Padding="10,3"
                    Margin="0,0,12,0" Click="BtnBericht_Click" IsEnabled="False"/>
            <Button DockPanel.Dock="Right" x:Name="BtnSchliessen" Content="Schließen" Width="110" IsCancel="True"
                    Click="BtnSchliessen_Click"/>
            <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" Foreground="DimGray" TextTrimming="CharacterEllipsis"
                       Margin="0,0,12,0"/>
        </DockPanel>
    </Grid>
</Window>
