<Window x:Class="Stundenplan_V2.Vertretung.SchildDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SchILD-Daten prüfen und importieren"
        Width="1120" Height="760"
        MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <!-- Phase 5.2a: Prüflauf eines SchILD-NRW-3-Exports (nur lesen, nichts senden), Pseudo-Export und (5.2a-2)
         Zuordnung SchILD ↔ Plan mit Festlegungen von Hand (schild_zuordnung.json); 5.2a-3: Muster der
         Kursbezeichnung und „gemeinsam mit …“; 5.2b-2b: Reiter „Import“ (SchildDialog_Import.cs) – sendet nur
         dort und nur Prüfsummen statt Geburtsdatum und SchILD-ID; 5.2b-2b-2: „Folgestand erzeugen…“
         (SchildDialog_Folgestand.cs); 5.2c-1: Paare „dieselbe Person?“ und „Schlüssel verloren – neu zuordnen…“;
         5.2c-2: Gruppen Namensgleicher und „Vorschlag übernehmen…“; P4b: Reiter „Rückweg“ (SchildDialog_Rueckweg.cs) –
         Fehlstunden mit Abholcode abholen und SchuelerFehlstunden.dat schreiben. -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="DimGray"
                   Text="Prüft einen Export aus SchILD-NRW 3 (Textdateien .dat). Die Dateien werden nur auf diesem Rechner gelesen. Gesendet wird nur im Reiter „Import“ – und dann statt Geburtsdatum und SchILD-ID nur Prüfsummen. Meldungen nennen bei Schülerdateien nur Datei, Zeile, Spalte und Grund."/>

        <DockPanel Grid.Row="1" Margin="0,0,0,6" LastChildFill="True">
            <TextBlock DockPanel.Dock="Left" Text="Ordner:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <Button DockPanel.Dock="Right" x:Name="BtnPruefen" Content="Prüflauf" Padding="14,3" Margin="6,0,0,0"
                    Click="BtnPruefen_Click"/>
            <Button DockPanel.Dock="Right" x:Name="BtnOrdner" Content="Ordner wählen…" Padding="10,3" Margin="6,0,0,0"
                    Click="BtnOrdner_Click"/>
            <TextBox x:Name="TxtOrdner" IsReadOnly="True" VerticalContentAlignment="Center"/>
        </DockPanel>

        <WrapPanel Grid.Row="2" Margin="0,0,0,8">
            <Border x:Name="BrdArt" Background="#EEEEEE" Padding="8,3" Margin="0,0,12,0" CornerRadius="3">
                <TextBlock x:Name="TxtArt" Text="Noch kein Ordner geprüft." TextWrapping="Wrap" MaxWidth="560"/>
            </Border>
            <TextBlock Text="Abschnitt:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="CbAbschnitt" Width="250" VerticalAlignment="Center" Margin="0,0,12,0"
                      DisplayMemberPath="Anzeige" SelectionChanged="CbAbschnitt_SelectionChanged"/>
            <TextBlock x:Name="TxtProfil" VerticalAlignment="Center" Foreground="DimGray"/>
        </WrapPanel>

        <TabControl Grid.Row="3" x:Name="Tabs">
            <TabItem Header="Übersicht">
                <DataGrid x:Name="DgZahlen" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          CanUserAddRows="False" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Bereich" Binding="{Binding Bereich}" Width="220"/>
                        <DataGridTextColumn Header="Angabe" Binding="{Binding Angabe}" Width="360"/>
                        <DataGridTextColumn Header="Wert" Binding="{Binding Wert}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <TextBlock x:Name="TxtProblemeKopf" Text="Probleme"/>
                </TabItem.Header>
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,4,0,4">
                        <TextBlock Text="Anzeigen:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <CheckBox x:Name="ChkFehler" Content="Fehler" IsChecked="True" Margin="0,0,12,0"
                                  VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                        <CheckBox x:Name="ChkWarnungen" Content="Warnungen" IsChecked="True" Margin="0,0,12,0"
                                  VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                        <CheckBox x:Name="ChkHinweise" Content="Hinweise" IsChecked="True"
                                  VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                    </WrapPanel>
                    <DataGrid x:Name="DgProbleme" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              CanUserAddRows="False" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Art" Binding="{Binding ArtText}" Width="75"/>
                            <DataGridTextColumn Header="Datei" Binding="{Binding Datei}" Width="200"/>
                            <DataGridTextColumn Header="Zeile" Binding="{Binding ZeileText}" Width="55"/>
                            <DataGridTextColumn Header="Spalte" Binding="{Binding Spalte}" Width="130"/>
                            <DataGridTemplateColumn Header="Grund" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Grund}" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <TextBlock x:Name="TxtZuordnungKopf" Text="Zuordnung"/>
                </TabItem.Header>
                <Grid Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" x:Name="BrdZuHinweis" Visibility="Collapsed" Background="#FDE2E1" Padding="8,4"
                            Margin="0,0,0,6" CornerRadius="3">
                        <TextBlock x:Name="TxtZuHinweis" TextWrapping="Wrap"/>
                    </Border>
                    <!-- 5.2a-3 (Entscheidung 137): Muster der Kursbezeichnung -->
                    <DockPanel Grid.Row="1" Margin="0,0,0,6" LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left" Text="Muster der Kursbezeichnung:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox DockPanel.Dock="Left" x:Name="TxtZuMuster" Width="230" VerticalContentAlignment="Center"
                                 IsEnabled="False" TextChanged="TxtZuMuster_TextChanged" KeyDown="TxtZuMuster_KeyDown"
                                 ToolTip="Wie heißen die Kurse im SchILD der Schule? Platzhalter: {Fach}, {Art}, {Nr} (Pflicht), {Jg} (Stufe bzw. Jahrgang) und {*} (beliebiger Text). Beispiele: {Fach}-{Art}{Nr} für „D-G2“, {Fach} {Art}{Nr} für „D GK1“, {Jg}-{Fach}-{Art}{Nr} für „Q1-D-G2“. Mehrere Muster mit ; trennen. Leer = automatisch (erste Ziffernfolge nach dem Fach). Gespeichert mit „Zuordnungen speichern“."/>
                        <Button DockPanel.Dock="Left" x:Name="BtnZuMuster" Content="Anwenden" Padding="10,3" Margin="6,0,10,0"
                                VerticalAlignment="Center" IsEnabled="False" Click="BtnZuMuster_Click"/>
                        <TextBlock x:Name="TxtZuMusterVorschau" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="DimGray"
                                   Text="Nach dem Prüflauf: Vorschau an Kursen aus dem Export."/>
                    </DockPanel>
                    <WrapPanel Grid.Row="2" Margin="0,0,0,4">
                        <TextBlock Text="Anzeigen:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="CbZuAnsicht" Width="360" VerticalAlignment="Center" Margin="0,0,12,0"
                                  SelectionChanged="CbZuAnsicht_SelectionChanged"/>
                        <CheckBox x:Name="ChkZuNurOffene" Content="nur offene und Vorschläge" VerticalAlignment="Center"
                                  Margin="0,0,12,0" Checked="ZuFilter_Changed" Unchecked="ZuFilter_Changed"/>
                        <TextBlock x:Name="TxtZuAnzahl" VerticalAlignment="Center" Foreground="DimGray"/>
                    </WrapPanel>
                    <DataGrid Grid.Row="3" x:Name="DgZuordnung" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                              SelectionMode="Single" SelectionChanged="DgZuordnung_SelectionChanged"/>
                    <Border Grid.Row="4" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="0,6,0,0" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock x:Name="TxtZuAuswahl" TextWrapping="Wrap" Margin="0,0,0,4"
                                       Text="Zeile wählen, um die Zuordnung von Hand festzulegen."/>
                            <WrapPanel>
                                <TextBlock Text="Festlegen auf:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CbZuPlan" Width="520" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ListBox x:Name="LbZuFaecher" SelectionMode="Multiple" Width="520" Height="96" Margin="0,0,8,0"
                                         Visibility="Collapsed" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>
                                <Button x:Name="BtnZuFestlegen" Content="Festlegen" Padding="10,3" Margin="0,0,6,0"
                                        VerticalAlignment="Center" IsEnabled="False" Click="BtnZuFestlegen_Click"/>
                                <Button x:Name="BtnZuEntfernen" Content="Festlegung entfernen" Padding="10,3"
                                        VerticalAlignment="Center" IsEnabled="False" Click="BtnZuEntfernen_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <DockPanel Grid.Row="5" Margin="0,8,0,0" LastChildFill="True">
                        <Button DockPanel.Dock="Left" x:Name="BtnZuVorschlaege" Content="Vorschläge übernehmen" Padding="10,3"
                                Margin="0,0,6,0" IsEnabled="False" Click="BtnZuVorschlaege_Click"/>
                        <!-- P5b-1 (245): Festlegungen von Hand aus dem Vorjahr übernehmen (nur Schlüssel im neuen Export ohne eigene Festlegung) -->
                        <Button DockPanel.Dock="Left" x:Name="BtnZuVorjahr" Content="Festlegungen aus dem Vorjahr übernehmen…"
                                Padding="10,3" Margin="0,0,6,0" Visibility="Collapsed" Click="BtnZuVorjahr_Click"/>
                        <Button DockPanel.Dock="Left" x:Name="BtnZuSpeichern" Content="Zuordnungen speichern" Padding="10,3"
                                Margin="0,0,12,0" IsEnabled="False" Click="BtnZuSpeichern_Click"/>
                        <TextBlock x:Name="TxtZuStatus" VerticalAlignment="Center" Foreground="DimGray"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Grid>
            </TabItem>
            <!-- 5.2b-2b: Import (Vorschau, Abgänge bestätigen, Importieren; Schlüssel sichern/einlesen) -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock x:Name="TxtImportKopf" Text="Import"/>
                </TabItem.Header>
                <Grid Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" x:Name="BrdImHinweis" Background="#EEEEEE" Padding="8,4" Margin="0,0,0,6" CornerRadius="3">
                        <TextBlock x:Name="TxtImHinweis" TextWrapping="Wrap" Text="Zuerst einen Ordner wählen und den Prüflauf starten."/>
                    </Border>
                    <DockPanel Grid.Row="1" Margin="0,0,0,6" LastChildFill="True">
                        <Button DockPanel.Dock="Right" x:Name="BtnImEinstellungen" Content="Online-Einstellungen…" Padding="10,3"
                                Margin="6,0,0,0" Click="BtnImEinstellungen_Click"/>
                        <Button DockPanel.Dock="Right" x:Name="BtnImStatus" Content="Status abfragen" Padding="10,3"
                                Margin="6,0,0,0" Click="BtnImStatus_Click"/>
                        <TextBlock x:Name="TxtImServer" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="DimGray"
                                   Text="Server: noch nicht abgefragt."/>
                    </DockPanel>
                    <WrapPanel Grid.Row="2" Margin="0,0,0,6">
                        <TextBlock Text="Änderungen gelten ab:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker x:Name="DpImGiltAb" Width="130" VerticalAlignment="Center" Margin="0,0,8,0"
                                    SelectedDateChanged="DpImGiltAb_SelectedDateChanged"
                                    ToolTip="Ab diesem Tag gelten Klassen-, Kurs- und Gruppenwechsel und Abgänge. Stunden davor behalten ihre Listen. Vorschlag der API: beim ersten Import eines Abschnitts dessen Beginn, sonst heute – nie vor dem letzten Import."/>
                        <TextBlock x:Name="TxtImGiltAb" VerticalAlignment="Center" Foreground="DimGray" Margin="0,0,18,0"
                                   TextWrapping="Wrap" MaxWidth="430"/>
                        <TextBlock x:Name="TxtImSchluessel" VerticalAlignment="Center" Margin="0,0,8,0" TextWrapping="Wrap"
                                   MaxWidth="380"/>
                        <Button x:Name="BtnImSichern" Content="Schlüssel sichern…" Padding="10,3" Margin="0,0,6,0"
                                VerticalAlignment="Center" IsEnabled="False" Click="BtnImSichern_Click"
                                ToolTip="Schreibt den Schlüssel in eine Datei mit Kennwort (für einen neuen Rechner oder Windows-Benutzer). Auf USB-Stick bzw. im Tresor aufbewahren, nicht in OneDrive."/>
                        <Button x:Name="BtnImEinlesen" Content="Schlüssel einlesen…" Padding="10,3" VerticalAlignment="Center"
                                Click="BtnImEinlesen_Click"
                                ToolTip="Liest eine Sicherung des Schlüssels ein (neuer Rechner oder anderer Windows-Benutzer)."/>
                        <!-- 5.2c-1 (Entscheidung 190): nur sichtbar, wenn der Schlüssel fehlt bzw. nicht zum letzten Import passt -->
                        <Button x:Name="BtnImNeu" Content="Schlüssel verloren – neu zuordnen…" Padding="10,3" Margin="6,0,0,0"
                                VerticalAlignment="Center" Visibility="Collapsed" Click="BtnImNeu_Click"
                                ToolTip="Nur wenn es keine Sicherung des bisherigen Schlüssels gibt: ordnet die schon importierten Schüler über Name + Klasse neu zu (eindeutige vorausgewählt, Namensgleiche von Hand). Gespeichert wird erst mit „Importieren…“."/>
                    </WrapPanel>
                    <WrapPanel Grid.Row="3" Margin="0,0,0,6">
                        <Button x:Name="BtnImVorschau" Content="Vorschau berechnen" Padding="14,3" Margin="0,0,6,0"
                                IsEnabled="False" Click="BtnImVorschau_Click"/>
                        <Button x:Name="BtnImImportieren" Content="Importieren…" Padding="14,3" Margin="0,0,6,0"
                                IsEnabled="False" Click="BtnImImportieren_Click"/>
                        <Button x:Name="BtnImBericht" Content="Bericht kopieren" Padding="10,3" Margin="0,0,6,0"
                                IsEnabled="False" Click="BtnImBericht_Click"
                                ToolTip="Kopiert den Bericht der Vorschau bzw. des Imports – ohne Schülernamen."/>
                        <Button x:Name="BtnImSeed" Content="Seed-Schüler entfernen…" Padding="10,3" Margin="18,0,0,0"
                                Visibility="Collapsed" Click="BtnImSeed_Click"
                                ToolTip="Nur Entwicklung: entfernt alle Pseudo-Schüler der Entwicklungsdatenbank (aus dem Seed und früher importierte) samt Klassenbuchdaten."/>
                    </WrapPanel>
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="330" MinWidth="220"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*" MinWidth="300"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="TxtImBericht" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" Background="#FAFAFA" Padding="4"/>
                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
                        <DockPanel Grid.Column="2">
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                <TextBlock Text="Anzeigen:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CbImAnsicht" Width="320" VerticalAlignment="Center" Margin="0,0,12,0"
                                          SelectionChanged="CbImAnsicht_SelectionChanged"/>
                                <TextBlock x:Name="TxtImAnzahl" VerticalAlignment="Center" Foreground="DimGray"/>
                            </WrapPanel>
                            <DataGrid x:Name="DgImport" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                      CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal"
                                      SelectionMode="Single">
                                <!-- 5.2c-2: Gruppen Namensgleicher der Neu-Zuordnung abwechselnd hinterlegt (Zeilen untereinander) -->
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GruppeFarbe}" Value="a">
                                                <Setter Property="Background" Value="#FFF6DD"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding GruppeFarbe}" Value="b">
                                                <Setter Property="Background" Value="#E6F0FA"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Bestätigen" Width="72" SortMemberPath="Bestaetigt">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <!-- P5b-2: ClickMode „Press“ – ein Klick genügt (sonst markiert der erste Klick nur die Zeile) -->
                                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" ClickMode="Press"
                                                          Visibility="{Binding BestaetigenSichtbar}"
                                                          IsChecked="{Binding Bestaetigt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          ToolTip="Abgang bestätigen: Zugehörigkeiten enden am Vortag von „gilt ab“, das Schülerkonto wird gesperrt. Bei Paaren („dieselbe Person?“, Neu-Zuordnung): zusammenführen bzw. zuordnen – danach „Vorschau berechnen“."/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <!-- 5.2b-2b-2: schmalere feste Spalten mit Umbruch, „Änderung“ und „Hinweis“ teilen den Rest 2 : 1 -->
                                    <DataGridTemplateColumn Header="Kategorie" Width="118" SortMemberPath="KategorieText">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding KategorieText}" TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Schüler" Width="130" SortMemberPath="Name">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Klasse" Binding="{Binding Klasse}" Width="50"/>
                                    <DataGridTextColumn Header="Jg." Binding="{Binding Stufe}" Width="34"/>
                                    <DataGridTemplateColumn Header="Änderung" Width="2*" MinWidth="150" SortMemberPath="Aenderung">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Aenderung}" TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Hinweis" Width="*" MinWidth="90" SortMemberPath="HinweisText">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding HinweisText}" TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                    <DockPanel Grid.Row="5" Margin="0,6,0,0" LastChildFill="True">
                        <Button DockPanel.Dock="Left" x:Name="BtnImAlle" Content="Alle in der Ansicht bestätigen" Padding="10,3"
                                Margin="0,0,6,0" IsEnabled="False" Click="BtnImAlle_Click"/>
                        <Button DockPanel.Dock="Left" x:Name="BtnImKeine" Content="Keine in der Ansicht" Padding="10,3"
                                Margin="0,0,12,0" IsEnabled="False" Click="BtnImKeine_Click"/>
                        <!-- 5.2c-2: Neu-Zuordnung – je Gruppe Namensgleicher den Vorschlag der API anhaken -->
                        <Button DockPanel.Dock="Left" x:Name="BtnImVorschlag" Content="Vorschlag übernehmen…" Padding="10,3"
                                Margin="0,0,12,0" Visibility="Collapsed" Click="BtnImVorschlag_Click"
                                ToolTip="Je Gruppe Namensgleicher die Paare mit passendem Eintritt bzw. den meisten gemeinsamen Kursen anhaken (nur eindeutige Vorschläge) – danach „Vorschau berechnen“."/>
                        <TextBlock x:Name="TxtImAuswahl" VerticalAlignment="Center" Foreground="DimGray" TextWrapping="Wrap"/>
                    </DockPanel>
                </Grid>
            </TabItem>
            <!-- P4b (5.3a, Entscheidungen 210–213): Rückweg nach SchILD -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock x:Name="TxtRwKopf" Text="Rückweg"/>
                </TabItem.Header>
                <Grid Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" x:Name="BrdRwHinweis" Background="#EEEEEE" Padding="8,4" Margin="0,0,0,6" CornerRadius="3">
                        <TextBlock x:Name="TxtRwHinweis" TextWrapping="Wrap" Text="Zuerst einen Ordner wählen und den Prüflauf starten."/>
                    </Border>
                    <WrapPanel Grid.Row="1" Margin="0,0,0,6">
                        <TextBlock Text="Abholcode aus der App:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="TxtRwCode" Width="120" MaxLength="12" CharacterCasing="Upper" VerticalContentAlignment="Center"
                                 FontFamily="Consolas" FontSize="15" Margin="0,0,6,0" TextChanged="TxtRwCode_TextChanged"
                                 ToolTip="App → Jahresablauf → „Rückweg nach SchILD“ → „Fehlstunden für SchILD bereitstellen…“ → „Abholcode erzeugen“. 8 Zeichen, 15 Minuten gültig, ein Abruf."/>
                        <Button x:Name="BtnRwAbrufen" Content="Abrufen" Padding="14,3" Margin="0,0,12,0" IsEnabled="False"
                                VerticalAlignment="Center" Click="BtnRwAbrufen_Click"/>
                        <TextBlock x:Name="TxtRwAbruf" VerticalAlignment="Center" Foreground="DimGray" TextWrapping="Wrap" MaxWidth="640"
                                   Text="Noch nichts abgeholt."/>
                    </WrapPanel>
                    <Grid Grid.Row="2" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Probedatei – nur diese" Foreground="DimGray"/>
                            <TextBlock Text="Klassen/Stufen (keine = alle):" Foreground="DimGray"/>
                        </StackPanel>
                        <ListBox Grid.Column="1" x:Name="LbRwKlassen" SelectionMode="Multiple" Height="52" Margin="0,0,8,0"
                                 SelectionChanged="LbRwKlassen_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                        <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="Zeitraum:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <DatePicker x:Name="DpRwVon" Width="120" VerticalAlignment="Center" SelectedDateChanged="DpRw_SelectedDateChanged"/>
                            <TextBlock Text="–" VerticalAlignment="Center" Margin="4,0"/>
                            <DatePicker x:Name="DpRwBis" Width="120" VerticalAlignment="Center" Margin="0,0,6,0"
                                        SelectedDateChanged="DpRw_SelectedDateChanged"/>
                            <Button x:Name="BtnRwAlle" Content="Alles" Padding="8,3" VerticalAlignment="Center" Click="BtnRwAlle_Click"
                                    ToolTip="Alle Klassen und der ganze abgeholte Zeitraum (keine Probedatei)."/>
                        </WrapPanel>
                    </Grid>
                    <WrapPanel Grid.Row="3" Margin="0,0,0,6">
                        <Button x:Name="BtnRwSchreiben" Content="Datei schreiben…" Padding="14,3" Margin="0,0,6,0" IsEnabled="False"
                                Click="BtnRwSchreiben_Click"
                                ToolTip="Schreibt SchuelerFehlstunden.dat in einen neuen Ordner „SchILD-Rueckweg_&lt;Datum&gt;“ – nicht in OneDrive, Teams oder einen anderen Cloud-Ordner."/>
                        <Button x:Name="BtnRwBericht" Content="Bericht kopieren" Padding="10,3" Margin="0,0,12,0" IsEnabled="False"
                                Click="BtnRwBericht_Click" ToolTip="Kopiert den Bericht – ohne Schülernamen."/>
                        <TextBlock x:Name="TxtRwAnzahl" VerticalAlignment="Center" Foreground="DimGray"/>
                    </WrapPanel>
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" MinWidth="220"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*" MinWidth="300"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="TxtRwBericht" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" Background="#FAFAFA" Padding="4"/>
                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
                        <DataGrid Grid.Column="2" x:Name="DgRueckweg" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                                  GridLinesVisibility="Horizontal" SelectionMode="Single" EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Schüler" Binding="{Binding Name}" Width="2*" MinWidth="140"/>
                                <DataGridTextColumn Header="Klasse" Binding="{Binding Klasse}" Width="55"/>
                                <DataGridTextColumn Header="Datum" Binding="{Binding DatumText}" Width="82" SortMemberPath="Datum"/>
                                <DataGridTextColumn Header="Std." Binding="{Binding StundenText}" Width="52" SortMemberPath="VonStd"/>
                                <DataGridTextColumn Header="Fehlstd." Binding="{Binding Anzahl}" Width="58"/>
                                <DataGridTextColumn Header="Entsch." Binding="{Binding JN}" Width="90"/>
                                <DataGridTextColumn Header="Fach" Binding="{Binding Fach}" Width="58"/>
                                <DataGridTextColumn Header="Lehrkraft" Binding="{Binding Lehrkraft}" Width="*" MinWidth="64"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    <TextBlock Grid.Row="5" x:Name="TxtRwMerk" Margin="0,6,0,0" Foreground="DimGray" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>
            <TabItem Header="Welche Dateien?">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TxtDateienHilfe" TextWrapping="Wrap" Margin="8" LineHeight="20"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="4" Margin="0,10,0,0" LastChildFill="True">
            <Button DockPanel.Dock="Left" x:Name="BtnPseudo" Content="Pseudo-Export erzeugen…" Padding="10,3"
                    Margin="0,0,6,0" Click="BtnPseudo_Click"/>
            <!-- 5.2b-2b-2 (Entscheidung 171): Folgestand aus einem geprüften Pseudo-Ordner (SchildDialog_Folgestand.cs) -->
            <Button DockPanel.Dock="Left" x:Name="BtnFolge" Content="Folgestand erzeugen…" Padding="10,3"
                    Margin="0,0,6,0" IsEnabled="False" Click="BtnFolge_Click" ToolTipService.ShowOnDisabled="True"/>
            <Button DockPanel.Dock="Left" x:Name="BtnProfil" Content="Formatprofil als Datei anlegen…" Padding="10,3"
                    Margin="0,0,6,0" Click="BtnProfil_Click"/>
            <Button DockPanel.Dock="Left" x:Name="BtnBericht" Content="Bericht kopieren" Padding="10,3"
                    Margin="0,0,12,0" Click="BtnBericht_Click" IsEnabled="False"/>
            <Button DockPanel.Dock="Right" x:Name="BtnSchliessen" Content="Schließen" Width="110" IsCancel="True"
                    Click="BtnSchliessen_Click"/>
            <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" Foreground="DimGray" TextTrimming="CharacterEllipsis"
                       Margin="0,0,12,0"/>
        </DockPanel>
    </Grid>
</Window>
