<Window x:Class="Stundenplan_V2.Vertretung.VertretungsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vertretung erfassen"
        Width="1500" Height="760"
        MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">

            <!-- ============ Reiter 1: Vertretung erfassen ============ -->
            <TabItem Header="Vertretung erfassen">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap"
                               Text="Abwesenheit eintragen (mehrere Namen kommagetrennt möglich) und 'Betroffene Stunden ermitteln'. Je Stunde Art und ggf. Vertretung wählen – die Liste ist nach fachgerecht, vertretungsbereit und Saldo sortiert (Minusstunden zuerst). Bei 'Klasse' als Abwesenheit sind die Stunden mit Entfall (−1) vorbelegt, wenn alle ihre Klassen fehlen (die Lehrkraft ist freigesetzt). 'Zählung' setzt einen eigenen Wert (−1/0/+1) nur mit Kommentar – nur für die Zählung, keine Gesundheitsangaben. 'neuer Raum' wechselt den Raum (bei 'Raum' als Abwesenheit = Raumsperre: Raumvertretung mit freiem Raum vorbelegt; belegte Räume stehen unten und brauchen eine Rückfrage). Mehrere markierte Zeilen lassen sich über die Leiste gemeinsam auf eine Art setzen. 'Buchen' schreibt alles in die Vertretungsdatei."/>

                    <!-- Eingabe der Abwesenheit -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Abwesend:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CbSubjekt" Width="110" VerticalAlignment="Center" Margin="0,0,14,0"
                                      SelectionChanged="CbSubjekt_SelectionChanged"/>
                            <TextBlock Text="Grund:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CbGrund" Width="150" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <TextBlock Text="Plan:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CbPlan" Width="130" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Von:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <DatePicker x:Name="DpVon" Width="130" VerticalAlignment="Center" Margin="0,0,6,0"
                                        SelectedDateChanged="DpVon_Changed"/>
                            <TextBlock Text="Std." VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="TxtVonStunde" Width="40" VerticalAlignment="Center" Margin="0,0,14,0"
                                     ToolTip="Default 1; leer = ab erster Stunde"/>
                            <TextBlock Text="Bis:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <DatePicker x:Name="DpBis" Width="130" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Std." VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="TxtBisStunde" Width="40" VerticalAlignment="Center" Margin="0,0,14,0"
                                     ToolTip="Default 11; leer = bis letzte Stunde"/>
                            <Button x:Name="BtnErmitteln" Content="Betroffene Stunden ermitteln" Padding="10,4"
                                    Click="BtnErmitteln_Click"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Namen:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="TxtNamen" Width="360" VerticalAlignment="Center" Margin="0,0,10,0"
                                     ToolTip="z. B. L1, L2  oder  05A, 05B – mehrere mit Komma trennen"/>
                            <ComboBox x:Name="CbName" Width="140" IsEditable="True" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button x:Name="BtnNameHinzu" Content="+ hinzufügen" Padding="8,3" Click="BtnNameHinzu_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Sammel-Aktion für markierte Zeilen -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Markierte Zeilen → Art:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="CbBulkArt" Width="150" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button x:Name="BtnBulkArt" Content="Setzen" Padding="10,3" Click="BtnBulkArt_Click"/>
                        <TextBlock Text="  (mehrere Zeilen mit Strg/Umschalt markieren)" VerticalAlignment="Center"
                                   Foreground="DimGray"/>
                    </StackPanel>

                    <!-- Betroffene Stunden -->
                    <DataGrid x:Name="DgInstanzen" Grid.Row="3" Margin="0,0,0,8"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              GridLinesVisibility="All" HeadersVisibility="All"
                              SelectionMode="Extended" SelectionUnit="FullRow">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IstGebucht}" Value="True">
                                        <!-- Nachtrag V1 (Nutzer 14.11.2026): kräftigeres Gelb; hebt sich von „Verlegung“
                                             #FFE0B2 und „Raumvertretung“ #FFF9C4 im Wocheneditor ab -->
                                        <Setter Property="Background" Value="#FFE082"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Datum" Binding="{Binding DatumText}" IsReadOnly="True" Width="95"/>
                            <DataGridTextColumn Header="Std" Binding="{Binding Stunde}" IsReadOnly="True" Width="45"/>
                            <DataGridTextColumn Header="Klasse(n)" Binding="{Binding KlassenText}" IsReadOnly="True" Width="110"/>
                            <DataGridTextColumn Header="Fach" Binding="{Binding Fach}" IsReadOnly="True" Width="90"/>
                            <!-- R3-D: Raum laut Raumplan (sonst Fachraum vor Stammraum) -->
                            <DataGridTextColumn Header="Raum" Binding="{Binding RaumText}" IsReadOnly="True" Width="80"/>
                            <DataGridTextColumn Header="entfällt bei" Binding="{Binding OrigLehrer}" IsReadOnly="True" Width="90"/>
                            <!-- V1: schon gebuchte Stunden – Zeile gelb, gespeicherte Art/Vertretung vorbelegt -->
                            <DataGridTextColumn Header="gebucht" Binding="{Binding GebuchtText}" IsReadOnly="True" Width="160"/>
                            <DataGridTemplateColumn Header="Art" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- F1 (09.11.2026): UpdateSourceTrigger=PropertyChanged ist nötig. Die Combo
                                             sitzt im CellTemplate (kein Bearbeitungsmodus); ohne den Zusatz schreibt
                                             die BindingGroup der Zeile die Auswahl erst beim Zeilen-Commit zurück –
                                             der nie stattfindet, „Buchen“ las dann die alte Art. -->
                                        <ComboBox ItemsSource="{Binding AlleArten}"
                                                  SelectedItem="{Binding Art, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Vertretung durch" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding Vorschlaege}"
                                                  DisplayMemberPath="Anzeige"
                                                  SelectedValuePath="Lehrer"
                                                  SelectedValue="{Binding GewaehlterVertreter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding BrauchtVertreter}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- R3-D: freie Räume dieser Stunde; „(wie bisher)“ = Raum laut Plan.
                                 R3-D-Nachtrag: Trennzeilen „– weitere Räume –“ und „– belegte Räume –“ (nicht wählbar);
                                 belegte Räume bewusst wählbar, Rückfrage beim Buchen. -->
                            <DataGridTemplateColumn Header="neuer Raum" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding RaumOptionen}"
                                                  DisplayMemberPath="Anzeige"
                                                  SelectedValuePath="Name"
                                                  SelectedValue="{Binding NeuerRaum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding RaumWaehlbar}">
                                            <ComboBox.ItemContainerStyle>
                                                <Style TargetType="ComboBoxItem">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IstTrenner}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                            <Setter Property="FontStyle" Value="Italic"/>
                                                            <Setter Property="Foreground" Value="DimGray"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ComboBox.ItemContainerStyle>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- V4 (278): Zählung je Zeile – „Standard (…)“ laut Art/Anlass oder eigener Wert (Sondergrund,
                                 Kommentar Pflicht). Feste Optionsliste je Zeile (nur der Standard-Text ändert sich), damit
                                 SelectedValue beim Neuzeichnen nicht auf null zurückfällt. -->
                            <DataGridTemplateColumn Header="Zählung" Width="125">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding ZaehlOptionen}"
                                                  DisplayMemberPath="Anzeige"
                                                  SelectedValuePath="Schluessel"
                                                  SelectedValue="{Binding ZaehlWahl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="{Binding ZaehlTipp}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Kommentar (Zählung)" Binding="{Binding Zaehlkommentar}" Width="170">
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="MaxLength" Value="200"/>
                                        <Setter Property="ToolTip" Value="Pflicht bei eigenem Zählwert – nur für die Zählung, keine Gesundheitsangaben"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Bemerkung" Binding="{Binding Bemerkung}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" Foreground="DimGray"
                                   Margin="0,0,16,0" TextTrimming="CharacterEllipsis"/>
                        <Button x:Name="BtnBuchen" Content="Buchen" Width="140" Click="BtnBuchen_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ============ Reiter 2: Tagesübersicht ============ -->
            <TabItem Header="Tagesübersicht">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Tag:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker x:Name="DpUebersicht" Width="140" VerticalAlignment="Center" Margin="0,0,12,0"
                                    SelectedDateChanged="DpUebersicht_Changed"/>
                        <CheckBox x:Name="ChkAlle" Content="alle Tage" VerticalAlignment="Center" Margin="0,0,12,0"
                                  Checked="ChkAlle_Changed" Unchecked="ChkAlle_Changed"/>
                        <Button x:Name="BtnUebersicht" Content="Aktualisieren" Padding="10,4" Click="BtnUebersicht_Click"/>
                        <Button x:Name="BtnPdfLehrer" Content="PDF (Lehrer-Sicht)" Padding="10,4" Margin="12,0,0,0"
                                Click="BtnPdfLehrer_Click"/>
                        <Button x:Name="BtnPdfAushang" Content="PDF (Aushang)" Padding="10,4" Margin="6,0,0,0"
                                Click="BtnPdfAushang_Click"/>
                        <TextBlock x:Name="TxtUebersichtInfo" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="DimGray"/>
                    </StackPanel>
                    <DataGrid x:Name="DgUebersicht" Grid.Row="1"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              GridLinesVisibility="All" HeadersVisibility="All">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Datum" Binding="{Binding DatumText}" Width="110"/>
                            <DataGridTextColumn Header="Std" Binding="{Binding Stunde}" Width="45"/>
                            <DataGridTextColumn Header="Klasse(n)" Binding="{Binding Klasse}" Width="110"/>
                            <DataGridTextColumn Header="Fach" Binding="{Binding Fach}" Width="80"/>
                            <DataGridTextColumn Header="Raum" Binding="{Binding Raum}" Width="110"/>
                            <DataGridTextColumn Header="entfällt bei" Binding="{Binding Orig}" Width="90"/>
                            <DataGridTextColumn Header="Art" Binding="{Binding ArtText}" Width="130"/>
                            <DataGridTextColumn Header="Vertretung" Binding="{Binding Vertreter}" Width="100"/>
                            <DataGridTextColumn Header="Grund" Binding="{Binding GrundText}" Width="110"/>
                            <!-- V4: Zählwert der Buchung (für die haltende bzw. die Lehrkraft laut Plan) -->
                            <DataGridTextColumn Header="Zählung" Binding="{Binding ZaehlText}" Width="120"/>
                            <DataGridTextColumn Header="Bemerkung" Binding="{Binding Bemerkung}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ============ Reiter 3: Zähler ============ -->
            <TabItem Header="Zähler">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Vertretungs- und Entfallzähler für das Schuljahr. Saldo = gehaltene Punkte + Entfälle (−1) + Sondergründe; die ausfallende Lehrkraft einer vertretenen Stunde zählt 0."
                                   VerticalAlignment="Center" Margin="0,0,16,0" TextWrapping="Wrap" MaxWidth="640"/>
                        <Button x:Name="BtnZaehlerAktualisieren" Content="Aktualisieren" Padding="10,4"
                                Click="BtnZaehlerAktualisieren_Click"/>
                        <Button x:Name="BtnZaehlerExcel" Content="Als Excel exportieren" Padding="10,4"
                                Margin="12,0,0,0" Click="BtnZaehlerExcel_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="DgZaehler" Grid.Row="1"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              GridLinesVisibility="All" HeadersVisibility="All">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Lehrkraft" Binding="{Binding Lehrer}" Width="120"/>
                            <DataGridTextColumn Header="Vertretung" Binding="{Binding Vertretung}" Width="90"/>
                            <DataGridTextColumn Header="Betreuung" Binding="{Binding Betreuung}" Width="90"/>
                            <DataGridTextColumn Header="EVA" Binding="{Binding EVA}" Width="60"/>
                            <DataGridTextColumn Header="Zusammenleg." Binding="{Binding Zusammenlegung}" Width="100"/>
                            <!-- V4 (280) -->
                            <DataGridTextColumn Header="Gehalten (Punkte)" Binding="{Binding GehaltenPunkte}" Width="115"/>
                            <DataGridTextColumn Header="Entfall 0" Binding="{Binding Entfall0}" Width="75"/>
                            <DataGridTextColumn Header="Entfall −1" Binding="{Binding EntfallMinus1}" Width="80"/>
                            <DataGridTextColumn Header="Sondergrund" Binding="{Binding Sondergruende}" Width="90"/>
                            <DataGridTextColumn Header="Sondergr. (Punkte)" Binding="{Binding SondergrundPunkte}" Width="115"/>
                            <DataGridTextColumn Header="Entfall gesamt" Binding="{Binding EntfallGesamt}" Width="100"/>
                            <DataGridTextColumn Header="Saldo" Binding="{Binding Saldo}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="1" Margin="0,8,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" x:Name="BtnSchliessen" Content="Schließen" Width="120"
                    IsCancel="True" Click="BtnSchliessen_Click"/>
        </DockPanel>
    </Grid>
</Window>
